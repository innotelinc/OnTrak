node_modules/
.next/
out/
build/
dist/

# env
.env
.env*.local

# production env for the compose overlays — a real deployment's secrets never
# belong in git. The `.example` templates beside them are tracked on purpose.
.env.production
.env.production.local

# prisma
prisma/migrations/dev.db*

# uploaded software packages (kept on disk, not in git)
storage/uploads/*
!storage/uploads/.gitkeep
storage/packages/*
!storage/packages/.gitkeep

# python
# `scripts/secret-scan.py` is imported by its own self-test (and by anything that
# imports it), which leaves bytecode behind. The scan reads untracked files on
# purpose, so a stray `.pyc` in the tree is content it would otherwise report on.
__pycache__/
*.py[cod]

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-error.log*
.vercel
*.tsbuildinfo
next-env.d.ts
coverage/

# playwright browser-a11y sweep
playwright-report/
test-results/

# tix attachment blob storage (local/single-node)
.ontrak-tix-blobs/

# tix evidence artifacts stored under object lock (local/single-node); the
# lock itself lives in the database, the bytes do not belong in git
.ontrak-tix-evidence/
