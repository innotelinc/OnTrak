// OnTrak Sentinel — S0 schema: the identity spine and the evidence log.
//
// Deliberately its own database: Sentinel issues identity for the other products
// but shares no tables with them, so a compromise in one cannot read the other's
// evidence. The first migration is `prisma/migrations/20260928000000_init`;
// the OIDC grant rows (`OidcClient`, `AuthorizationCode`, `AccessToken`) arrive
// in `20260929000000_oidc`, and SAML service providers plus access-token
// revocation (`SamlServiceProvider`, `AccessToken.revokedAt`) in
// `20260930000000_logout_saml`. TOTP enrollment state (`MfaFactor.confirmedAt`,
// `lastUsedAt`, `lastUsedCounter`) arrives in `20261001000000_mfa_totp`, WebAuthn
// credential state (`MfaFactor.publicKey`, `MfaFactor.signCount`,
// `WebAuthnChallenge`) in `20261015000000_webauthn`, and provisioning
// (`Identity.externalId`, `ScimToken`, `Group`, `GroupMember`) in
// `20261020000000_scim`, per-role policies (`IdentityPolicy.scope`) in
// `20261025000000_policy_scope`, and inbound directory reads (`DirectoryConnection`,
// `DirectorySyncRun`) in `20261026000000_directory_sync`, and Guard's detection output
// (`Alert`) in `20261027000000_guard_alert`.
//
// Two shapes are worth reading before the rest:
//
//  - Every record below carries the `organizationId` it belongs to, and every
//    relation is scoped by it. An organization is an MSP or one internal IT
//    department; nothing crosses that line, so a query that forgets to scope
//    itself is a visible mistake rather than a silent cross-tenant read.
//  - `AuditEvent.seq` is the position *inside one organization's chain*, not a
//    global row number: the spine keeps a separate hash chain per organization
//    (`src/lib/audit-chain.ts`), so the uniqueness that matters is
//    `(organizationId, seq)`. Rows are append-only — never updated, never
//    deleted.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Isolation boundary: an MSP, or one internal IT department.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  identities         Identity[]
  credentials        Credential[]
  mfaFactors         MfaFactor[]
  webauthnChallenges WebAuthnChallenge[]
  policies           IdentityPolicy[]
  sessions           Session[]
  audit              AuditEvent[]

  // Provisioning (S2): the credentials a directory connector authenticates with,
  // the groups it keeps in sync, and the directories Sentinel reads itself.
  scimTokens   ScimToken[]
  groups       Group[]
  directories  DirectoryConnection[]
  directoryRuns DirectorySyncRun[]
  // ...and the other half of the lifecycle: somebody periodically attesting that the
  // access the directory granted should still be there.
  accessReviews         AccessReview[]
  accessReviewItems     AccessReviewItem[]
  accessReviewSchedules AccessReviewSchedule[]

  // Guard (S3): what detection decided about the telemetry it was sent, and what
  // somebody has published as worth watching.
  alerts     Alert[]
  indicators Indicator[]
  // Guard (S4): what the deployment then *did* about it. An action is state that outlives
  // the request that created it — a block stands until something lifts it — so it is a row
  // rather than a return value, and the policy it was judged against is a row beside it.
  enforcementActions  EnforcementAction[]
  enforcementPolicies EnforcementPolicy[]

  // The OIDC surface (S1): who we issue identity to, and the grants in flight.
  oidcClients  OidcClient[]
  authCodes    AuthorizationCode[]
  accessTokens AccessToken[]
  // The SAML surface (S1): the same question — who receives identity — asked
  // with a different protocol.
  samlServiceProviders SamlServiceProvider[]
}

/// One enforcement action (S4), and its life: proposed, applied, lifted or refused.
///
/// The interesting columns are the ones that make an action *answerable* afterwards.
///
///   * `state` is one of `PENDING` | `ACTIVE` | `LIFTED` | `REFUSED`, narrowed on read.
///     `REFUSED` is a state rather than an error because a refused attempt is evidence:
///     somebody asked to block something and a rail stopped them.
///   * `rollback` is the inverse, computed when the decision was made and stored *with*
///     the action. Recomputing it later would mean recomputing it from a policy that has
///     since been edited, and the inverse of an action is a fact about the action.
///   * `expiresAt` is the deadline the action lifts itself at, or null when it stands until
///     lifted by hand. It is read by the expiry sweep, which is what makes
///     "reversible by default" a mechanism rather than a promise.
///   * `refusedCode` / `refusedReason` keep the rail that refused, so a review can tell
///     "the safe-list stopped it" from "it needed a second approver that never came".
///
/// `appliedAt` is indexed on its own because the rate limit is a question about time —
/// `recentAppliedAt` asks for the actions applied since an hour ago — and the rate limit is
/// the rail that has to be cheap to check.
model EnforcementAction {
  id             String  @id @default(cuid())
  organizationId String
  /// `BLOCK` | `QUARANTINE` | `RATE_LIMIT`, narrowed on read.
  action         String
  state          String  @default("PENDING")
  /// The targets, as the decision took them: kind, value and a label for the audit row.
  targets        Json
  /// The alert this answers. An enforcement action with no detection behind it is not one.
  alertId        String
  reason         String
  requestedById  String
  requestedByLabel String
  /// The requester's role when they asked, not at approval time — the approval re-decides
  /// the whole request, and "was prevention theirs to take" is part of that decision.
  requestedByRole String
  approvedById   String?
  approvedByLabel String?
  appliedAt      DateTime?
  expiresAt      DateTime?
  liftedAt       DateTime?
  liftedById     String?
  liftedByLabel  String?
  liftReason     String?
  refusedCode    String?
  refusedReason  String?
  /// The inverse of this action, stored rather than derived (see the note above).
  rollback       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, state])
  @@index([organizationId, appliedAt])
  @@index([organizationId, alertId])
}

/// The rails an organization's enforcement is judged against (S4).
///
/// One row per organization, because a policy is what the *deployment* enforces with —
/// rules are code, and this is the part that has to be configurable without a release.
/// The whole policy is one `Json` column rather than a column per rail: it is read whole, on
/// every decision, and a half-applied policy would be a set of rails nobody can reason about.
model EnforcementPolicy {
  organizationId String   @id
  policy         Json
  updatedById    String?
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/// A human, service or machine identity.
model Identity {
  id             String       @id @default(cuid())
  organizationId String
  /// Email for humans, or a service name for machines.
  identifier     String
  displayName    String
  kind           IdentityKind @default(HUMAN)
  role           IdentityRole @default(AGENT)
  active         Boolean      @default(true)
  /// Whether a second factor is enrolled. Read by every session decision, so it
  /// is stored rather than recomputed from the factors on each read.
  mfaEnrolled    Boolean      @default(false)
  /// The identifier the *source directory* knows this person by (SCIM's
  /// `externalId`), or `null` for an identity that was typed into the console.
  /// This is the column that makes a rename safe: a connector matching on the user
  /// name alone would create a second identity for somebody who changed their name,
  /// and orphan the first — with its sessions, its factors and its history.
  externalId     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  credentials        Credential[]
  mfaFactors         MfaFactor[]
  webauthnChallenges WebAuthnChallenge[]
  sessions           Session[]
  groupMemberships   GroupMember[]
  accessReviewItems  AccessReviewItem[]

  @@unique([organizationId, identifier])
  /// Unique when present, and deliberately not across the NULLs: Postgres treats
  /// NULLs as distinct, so an identity that came from a directory and one typed into
  /// the console are both ordinary, and neither blocks the other.
  @@unique([organizationId, externalId])
  @@index([organizationId, role])
}

enum IdentityKind {
  HUMAN
  SERVICE
}

enum IdentityRole {
  ADMIN
  AGENT
  SERVICE
  AUDITOR
}

/// A secret *hash* — never a plaintext secret, so a database copy is not a
/// credential dump.
model Credential {
  id             String   @id @default(cuid())
  organizationId String
  identityId     String
  /// Argon2id/scrypt hash.
  hash           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  identity     Identity     @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([identityId])
}

/// An enrolled second factor (S1).
///
/// `confirmedAt` is the field that decides whether this factor counts: `null`
/// means somebody generated a secret and nobody has proved they hold it, which is
/// an enrollment in progress and never satisfies the session policy. The policy
/// reads `Identity.mfaEnrolled`, which `MfaService.confirmEnrollment` sets only
/// after a code from this secret verifies — so "enrolled" is a fact about a code
/// that was accepted, not a checkbox.
///
/// `secret` holds a TOTP shared secret and is therefore the one value in Sentinel
/// that has to be readable rather than hashed (a code is computed *from* it). The
/// deployment is expected to encrypt this column at rest, exactly as it encrypts a
/// webhook signing secret; the columns here do not pretend otherwise. For a
/// `WEBAUTHN` factor `secret` holds the credential id instead — a value an assertion
/// arrives naming, and one that has to be readable to be matched — and the public key
/// lives in `publicKey`, where being readable is not a risk at all.
model MfaFactor {
  id             String   @id @default(cuid())
  organizationId String
  identityId     String
  kind           MfaKind
  /// TOTP: the base32 secret. WebAuthn: the base64url credential id.
  secret         String
  /// WebAuthn only: the COSE public key, as JSON. A public key is not a secret, so
  /// this one column is safe to read back — and losing it means the key can never
  /// answer an assertion again.
  publicKey      String?
  /// WebAuthn only: the last signature counter an assertion reported. A counter
  /// that goes backwards is how a cloned authenticator is noticed, so the previous
  /// value has to outlive the assertion that replaced it.
  signCount      Int?
  /// What the user called it, or nothing.
  label          String?
  /// Set the first time a code from this factor verifies. `null` is an enrollment.
  confirmedAt    DateTime?
  lastUsedAt     DateTime?
  /// The last RFC 6238 step a code was accepted for, so a code cannot be replayed
  /// inside its own window.
  lastUsedCounter Int?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  identity     Identity     @relation(fields: [identityId], references: [id], onDelete: Cascade)

  /// Deliberately not unique on `(organizationId, identityId, kind)`: v1 issues one
  /// TOTP factor an identity, but WebAuthn wants several keys per identity, and a
  /// unique constraint added for today's convenience is a migration tomorrow.
  @@index([organizationId, identityId, kind])
  @@index([identityId])
}

enum MfaKind {
  TOTP
  WEBAUTHN
}

/// A credential a directory connector authenticates with (S2).
///
/// Stored as `SHA-256(token)`, never as the token — the same rule as every other
/// credential in the product, and the reason a copy of this database is not a set of
/// working tokens. The plaintext exists in exactly one place: the response to the
/// console request that minted it. `revokedAt` is a timestamp rather than a boolean so
/// the record says *when* a connector stopped being trusted.
model ScimToken {
  id             String    @id @default(cuid())
  organizationId String
  /// What the administrator called it, e.g. “Entra ID — production”.
  label          String?
  tokenHash      String    @unique
  /// Who minted it. The connector acts as this delegation, never as this person:
  /// every write it makes is audited as `scim:<tokenId>`.
  createdBy      String
  createdAt      DateTime  @default(now())
  /// How somebody answers “is this token still in use?” before revoking it.
  lastUsedAt     DateTime?
  revokedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// A directory group (S2): membership, recorded and auditable.
///
/// Deliberately **not** an authorization object in v1. Roles, groups and
/// attribute-based policy are the rest of S1, and until they land a group decides
/// nothing — which is stated here rather than implied, because a group that looked
/// like it granted something and did not would be worse than one that plainly does not
/// yet. What is here is the synced fact: who is in it.
model Group {
  id             String   @id @default(cuid())
  organizationId String
  displayName    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      GroupMember[]

  @@unique([organizationId, displayName])
}

/// One membership. The pair is the key, so a connector re-sending the same membership
/// cannot create a second row and a retry is a no-op rather than an error.
model GroupMember {
  groupId    String
  identityId String
  createdAt  DateTime @default(now())

  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  identity Identity @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@id([groupId, identityId])
  @@index([identityId])
}

/// One detection, as an alert (S3).
///
/// Deliberately *not* a copy of the telemetry. The roadmap says why: high-volume
/// observations belong in a columnar/time-series store, and pretending Postgres is one is
/// how a detection platform gets slow exactly when it is needed. What is stored here is
/// the conclusion — which rule fired, at which version, about whom — plus the bounded
/// evidence that conclusion was drawn from, so an operator reading an alert at 09:00 sees
/// the same bytes the rule saw at 03:00.
///
/// `(organizationId, dedupeKey)` is unique, and that is the load-bearing constraint: the
/// key is derived from what the observation *is* (the five-tuple and a clock bucket), not
/// from a vendor's alert id, so two sensors reporting one connection update one row and a
/// repeat is an updated occurrence count rather than a second incident. The service relies
/// on this rather than on a read-then-write, because ingestion is concurrent by nature.
///
/// `identityId` / `identityLabel` are filled when the event's address matches an address a
/// session was granted from — the join that makes this an *identity-aware* platform rather
/// than an IDS. They are nullable and stay nullable: an unattributable event is a fact, and
/// inventing an owner for it would be worse than saying nobody knows.
model Alert {
  id             String    @id @default(cuid())
  organizationId String
  ruleId         String
  /// Which version of the rule fired, so an alert is judged by the code that ran.
  ruleVersion    Int
  ruleName       String
  severity       String
  /// `NEW` | `ACKNOWLEDGED` | `CLOSED`.
  state          String    @default("NEW")
  dedupeKey      String
  groupKey       String
  sourceAddress  String?
  identityId     String?
  /// The identity's address at the time, so a closed alert still reads.
  identityLabel  String?
  device         String?
  asset          String?
  firstSeenAt    DateTime
  lastSeenAt     DateTime
  occurrences    Int       @default(1)
  /// The observations the rule fired on, bounded by `ALERT_EVIDENCE_MAX`.
  evidence       Json
  /// The indicators of compromise the evidence matched, each with the field it was seen
  /// on, the feed it came from and the feed's confidence.
  ///
  /// `[]` rather than null, and defaulted rather than required, because "nothing matched"
  /// is a real answer and because it makes the column safe to add to rows that already
  /// exist: a deployment upgrading in place gets an empty list, not a null every reader has
  /// to special-case. Carried on the row rather than looked up when the alert is read, for
  /// the same reason the evidence is — a feed is edited and a list is pruned, and an alert
  /// read next month has to say what was known when it was raised.
  threatIntel    Json      @default("[]")
  /// An operator's reason when they acknowledged or closed it.
  note           String?
  /// The person who owns this alert, or null for one nobody has picked up.
  ///
  /// An id *and* a label, as `identityId`/`identityLabel` are: an identity is renamed and
  /// deactivated, and an alert read next month has to be able to say who was asked to look at
  /// it. The label is written when the alert is handed over rather than resolved on every read.
  assigneeId     String?
  assigneeLabel  String?
  /// When it was handed over, so a row can say how long somebody has been holding it.
  assignedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, state, lastSeenAt])
}

/// One indicator of compromise (S3): an address, block, domain, URL or digest that a feed
/// has published as worth watching.
///
/// Four columns carry decisions worth reading:
///
///  - **The primary key is `(organizationId, id)`, and the id is *derived* from the kind and
///    the canonical value** rather than generated. Derived is what makes polling a feed an
///    update instead of a table that grows by the feed's size every hour — the same property
///    `Alert.dedupeKey` gives a burst, applied to data rather than to a detection. Scoping the
///    key to the organization is what keeps that safe across tenants: two organizations
///    watching the same address is one row each, and one of them withdrawing it cannot reach
///    the other's. A single global key on the derived id would make the second tenant's first
///    ingest a constraint violation — a cross-tenant denial of service.
///  - **`source` is required and is never defaulted.** An indicator whose provenance is
///    unknown cannot be withdrawn when the feed turns out to be wrong, and "which feed told us
///    this?" is the first question asked about a false positive.
///  - **`confidence` is stored, not assumed.** A match below the floor the matcher applies
///    annotates an alert instead of escalating it, so the number has to survive the round trip
///    or the judgement changes when the process restarts.
///  - **`expiresAt` is nullable, and null means "does not expire".** A list nobody pruned
///    reports the innocent for years after an address is reassigned, so the expiry is stored
///    where a deployment can see how much of its feed has one.
model Indicator {
  /// `kind-canonicalvalue`, hashed — see `indicatorId` in `threat-intel-rules.ts`.
  id             String
  organizationId String
  /// `IPV4` | `IPV6` | `CIDR` | `DOMAIN` | `URL` | `MD5` | `SHA1` | `SHA256`.
  kind           String
  /// The canonical spelling, so two feeds naming one address are one row.
  value          String
  /// Whether the value was given as `*.` — the domain and anything under it.
  wildcard       Boolean  @default(false)
  /// The feed this came from, named.
  source         String
  /// 0–100. Below the matcher's floor a hit annotates rather than escalates.
  confidence     Int      @default(60)
  /// The feed's own severity for a hit, when it has an opinion. Never lowers a rule's.
  severity       String?
  /// The feed's own tags, kept because they are what makes a hit explainable.
  labels         String[]
  firstSeenAt    DateTime
  /// `null` means it does not expire, which a deployment should be able to count.
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, id])
  @@index([organizationId, source])
}

/// A directory Sentinel *reads* (S2): AD, Entra or Google, configured once and
/// synced on demand.
///
/// The other half of S2. A `ScimToken` is how a connector pushes people *to* us; this is
/// how we pull them, so an organization that runs Microsoft 365 or Google Workspace can
/// start without standing up a connector.
///
/// Two columns carry decisions worth reading. `conflictPolicy` says whose edit wins when
/// the directory and a change made here disagree - a named policy rather than a boolean,
/// because "the directory is the source of truth" and "a change here is a decision" are
/// both defensible. `lastSyncedAt` is what makes a *local* edit detectable at all: it is
/// only advanced by a run that finished cleanly, so a failed sync cannot quietly stop
/// protecting changes made in the console.
///
/// `secret` is the one value here that has to be readable rather than hashed - a client
/// secret or bind password is needed to call the directory - so it is documented as the
/// deployment's to encrypt, exactly as `MfaFactor.secret` is. It never leaves this table
/// on the record the console renders: readers ask for it by id at the moment they use it.
model DirectoryConnection {
  id             String       @id @default(cuid())
  organizationId String
  /// What the administrator called it, e.g. “Entra ID — production”.
  name           String
  /// `ENTRA` | `GOOGLE` | `LDAP` | `GENERIC`, narrowed on read.
  source         String
  /// Non-secret settings: tenant id, host, base DN, group filter.
  settings       Json
  secret         String?
  conflictPolicy String       @default("preferDirectory")
  defaultRole    IdentityRole @default(AGENT)
  /// When the last *completed* sync finished. `null` means nothing here is known to be
  /// the directory's, so `preferLocal` protects every identity in the organization.
  lastSyncedAt   DateTime?
  createdBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         DirectorySyncRun[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

/// One sync, recorded (S2).
///
/// "What did last night's sync do?" is a question with a wrong answer people repeat, so
/// the counts and the reason for every skip are stored rather than only logged. A failed
/// pull writes a row too: the run that *did not* happen is exactly the one somebody will
/// be asking about.
model DirectorySyncRun {
  id             String   @id @default(cuid())
  organizationId String
  connectionId   String
  startedAt      DateTime
  finishedAt     DateTime
  /// `COMPLETED` | `FAILED`.
  status         String
  counts         Json
  detail         String?

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   DirectoryConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([organizationId, connectionId, startedAt])
}

/// A WebAuthn ceremony in progress (S1).
///
/// Server-side state rather than a signed blob handed to the browser, because the
/// property that matters is **accepted exactly once** and that is a fact about a
/// row, not about a value we emitted. `usedAt` is written by a conditional
/// `updateMany` (the same trick `AuthorizationCode.markCodeUsed` uses), so two
/// workers racing on one challenge produce one verified ceremony and one refusal —
/// which a per-process cache could not promise. `expiresAt` bounds how long a
/// challenge somebody logged is worth anything.
model WebAuthnChallenge {
  id             String   @id @default(cuid())
  organizationId String
  identityId     String
  /// `REGISTRATION` | `AUTHENTICATION`, narrowed on read.
  ceremony       String
  /// Base64url. What `clientDataJSON` has to carry back.
  challenge      String
  /// The origin ceremonies must run on, compared exactly.
  origin         String
  /// The relying party id whose SHA-256 the authenticator data must carry.
  rpId           String
  createdAt      DateTime @default(now())
  expiresAt      DateTime
  usedAt         DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  identity     Identity     @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([organizationId, identityId, ceremony])
  @@index([expiresAt])
}

/// The organization's session policy (S0, per-role since S1).
///
/// `scope` is `"ALL"` for the baseline every identity is judged by, or a role name
/// for an override that beats it. It is a plain string rather than a Prisma enum so
/// a role added later is a value rather than a migration, and the pair
/// `(organizationId, scope)` is the row's identity — an administrator *edits* the
/// AGENT policy, they do not accumulate copies of it.
model IdentityPolicy {
  id             String   @id @default(cuid())
  organizationId String
  scope          String   @default("ALL")
  requireMfa     Boolean  @default(true)
  maxSessionSec  Int      @default(43200)
  idleTimeoutSec Int      @default(1800)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, scope])
}

model Session {
  id             String    @id @default(cuid())
  organizationId String
  identityId     String
  issuedAt       DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  /// When the session stops being usable on age alone, computed at grant time.
  expiresAt      DateTime
  revokedAt      DateTime?
  /// Device/IP metadata captured at grant time, for later correlation.
  userAgent      String?
  ipAddress      String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  identity     Identity     @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([identityId])
}

/// Append-only, hash-chained evidence log. Rows are never updated or deleted.
/// `seq` is the position within one organization's chain; `prevHash` links to
/// the previous record and `recordHash` commits to this record's canonical
/// payload (see `src/lib/audit-chain.ts`).
model AuditEvent {
  id             String   @id
  organizationId String
  /// Position inside this organization's chain, starting at 1.
  seq            Int
  at             DateTime
  actor          String
  action         String
  targetType     String?
  targetId       String?
  detail         Json?
  prevHash       String
  recordHash     String
  /// Optional signature over `recordHash` for periodic checkpoints.
  signature      String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, seq])
  @@index([organizationId, at])
  @@index([action])
}

/// A registered OIDC client: an application the organization has allowed to be
/// handed its identity. `clientId` is the primary key because the token endpoint
/// is reached with that value alone — there is no tenant hint in the request, so
/// it has to be globally unique.
model OidcClient {
  clientId       String   @id
  organizationId String
  name           String
  /// Exact match only, so they are stored as a list rather than as a rule.
  redirectUris   String[]
  scopes         String[]
  kind           String   @default("public")
  createdBy      String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  codes        AuthorizationCode[]
  tokens       AccessToken[]

  @@index([organizationId])
}

/// A code handed to a browser, worth one exchange inside a minute.
///
/// `usedAt` is written by a conditional update (`where: { code, usedAt: null }`)
/// rather than read-then-write, because two exchanges racing on one code is
/// exactly the replay the flow exists to prevent.
model AuthorizationCode {
  code                String    @id
  organizationId      String
  clientId            String
  redirectUri         String
  scopes              String[]
  identityId          String
  sessionId           String
  nonce               String?
  codeChallenge       String
  codeChallengeMethod String    @default("S256")
  issuedAt            DateTime
  expiresAt           DateTime
  usedAt              DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       OidcClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@index([organizationId])
  /// For the sweep that clears codes nobody came back for.
  @@index([expiresAt])
}

/// An issued access token, keyed by `SHA-256(token)` rather than by the token.
/// A copy of this table is therefore a list of sessions that have ended, not a
/// set of credentials that work.
model AccessToken {
  tokenHash      String    @id
  organizationId String
  clientId       String
  identityId     String
  sessionId      String
  scopes         String[]
  issuedAt       DateTime
  expiresAt      DateTime
  /// Set when the token is revoked — by RFC 7009, or because the session behind
  /// it was signed out. A timestamp rather than a boolean, so the record says
  /// *when* it stopped working. `null` means never revoked, not "expired".
  revokedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       OidcClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)

  @@index([organizationId])
  @@index([expiresAt])
  /// For sign-out, which revokes every token a session holds in one statement.
  @@index([organizationId, sessionId, revokedAt])
}

/// A registered SAML 2.0 service provider (S1): an application the organization
/// has allowed Sentinel to hand a signed assertion to. The SAML counterpart of
/// `OidcClient`, and deliberately a separate table rather than a widened one —
/// the two protocols answer the same question with different fields (`acsUrls`
/// and a `entityId` against `redirectUris` and `scopes`), and pretending they are
/// one record would mean every reader checking which half it is looking at.
///
/// `entityId` is the primary key because an AuthnRequest arrives naming it and
/// nothing else; resolving the tenant from `acsUrls` would mean accepting a
/// destination first and asking whose it was afterwards.
model SamlServiceProvider {
  entityId       String   @id
  organizationId String
  name           String
  /// Assertion Consumer Service URLs. Exact match only, and `acsUrls[0]` is the
  /// one metadata advertises as the default binding target.
  acsUrls        String[]
  nameIdFormat   String   @default("urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress")
  createdBy      String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// One access review: the campaign in which somebody periodically attests that the
/// people holding access should still have it (S2).
///
/// The whole point is that the answer is *recorded per person* rather than being a
/// formality somebody signs. `AccessReviewItem.decision` therefore defaults to
/// `PENDING`, not to `KEPT`: an item nobody looked at is not an approval, and the
/// difference between "reviewed and kept" and "nobody got to it" is the only thing an
/// auditor is actually asking about.
///
/// `reviewerId` is a named person, not a derived role. A role would have made the
/// meaning of a finished review change the day somebody's role did, which is the one
/// thing an attestation must not do — the record has to say who was asked, and it has
/// to keep saying it.
model AccessReview {
  id             String    @id @default(cuid())
  organizationId String
  /// What an administrator called it, e.g. “Service desk — quarter end”.
  name           String
  /// `ORGANIZATION` | `GROUP`, narrowed on read.
  scopeKind      String
  /// The group id when `scopeKind` is `GROUP`; empty for an organization-wide review.
  scopeValue     String    @default("")
  reviewerId     String
  dueAt          DateTime
  /// `OPEN` | `COMPLETED` | `CANCELLED`, narrowed on read. Being late is *derived*
  /// from `dueAt` rather than stored, because a stored flag is one a scheduler that
  /// did not run leaves wrong.
  status         String    @default("OPEN")
  /// The schedule that opened it, or `null` when somebody opened it by hand.
  scheduleId     String?
  createdBy      String
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        AccessReviewItem[]
  schedule     AccessReviewSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([reviewerId])
}

/// One person on one review's list, and what the reviewer decided about them.
model AccessReviewItem {
  id             String    @id @default(cuid())
  organizationId String
  reviewId       String
  identityId     String
  /// `PENDING` | `KEPT` | `REVOKED`, narrowed on read.
  decision       String    @default("PENDING")
  decidedBy      String?
  decidedAt      DateTime?
  /// Why, in the reviewer's words. Optional, because a `KEPT` with a reason would be
  /// noise, and a `REVOKED` without one is a decision somebody will ask about.
  note           String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  review       AccessReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  identity     Identity     @relation(fields: [identityId], references: [id], onDelete: Cascade)

  /// The pair is the key, so an identity cannot appear on one review's list twice —
  /// two rows for one person would make “how many are outstanding?” ambiguous.
  @@unique([reviewId, identityId])
  @@index([organizationId])
  @@index([identityId])
}

/// A recurring attestation: the schedule that opens a review without anybody
/// remembering to. A review nobody schedules is a review that stops happening.
model AccessReviewSchedule {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  scopeKind      String
  scopeValue     String    @default("")
  reviewerId     String
  /// How often a review is opened, in days. Bounded by the rules module, because an
  /// interval of zero would open one per tick and an interval of years is a schedule
  /// that exists to be pointed at.
  intervalDays   Int
  nextRunAt      DateTime
  lastRunAt      DateTime?
  enabled        Boolean   @default(true)
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviews      AccessReview[]

  @@unique([organizationId, name])
  @@index([organizationId])
  /// The scheduler asks one question — what is due — so it is an index.
  @@index([nextRunAt])
}
