[TEMPLATE]
# ---------------------------------------------------------------------------
# OnTrak Sentinel — production configuration.
#
# Copy to `.env.production` and fill it in:
#
#     cp .env.production.example .env.production
#     make sentinel-prod-up
#
# `.env.production` is gitignored and must never be committed — this template
# carries placeholders only, never a real value.
#
# OPTIONAL — which release this deployment runs. The overlay pulls every image it
# names with the same tag, so one value moves the whole thing: leave it unset to
# follow `latest`, the build the last release published and the default, or set a
# version to hold this deployment on one build — the rollback path.
# ONTRAK_IMAGE_TAG=0.1.1
#
# The overlay `docker-compose.prod.yml` refuses to start without the three
# REQUIRED values below. Two of them have no working development default at all:
# an ephemeral signing key and a loopback issuer both produce a provider that
# looks healthy and hands out tokens nothing outside this host can accept.
#
# In a stack deployment the secrets are Cerulean Vault references the deployment
# resolves before the provider starts (`vault://<mount>/<path>#<key>`), not
# literals.
# ---------------------------------------------------------------------------

# REQUIRED — the RSA private key every ID token is signed with, as PEM.
#
# Do not write the key here or in any tracked file: the scanner in
# `scripts/secret-scan.py` rejects a private-key block on sight, and so does the
# host's push protection. Generate one and paste the *escaped single line* it
# prints between the quotes:
#
#     make sentinel-key
#
# which is:
#
#     openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 2>/dev/null \
#       | awk 'NF {printf "%s\n", $0}'
#
# Compose expands `\n` in a double-quoted value, so the key arrives at the
# provider as the multi-line PEM it has to be. An ephemeral key is fine for
# `docker compose up` and wrong here: restarting would silently invalidate every
# token the provider has ever issued.
SENTINEL_SIGNING_KEY=""

# REQUIRED — the password the Postgres role is created with. Note that changing
# it later does not change an existing database's password: that needs
# `ALTER USER ontrak WITH PASSWORD ...` against the running database.
POSTGRES_PASSWORD=""

# REQUIRED — the origin clients verify against. It prefixes every advertised
# endpoint, it is the `iss` in every ID token, and it is the WebAuthn origin the
# console runs ceremonies on. It must therefore be the address a *client*
# reaches — a real name behind the platform's proxy and certificate, not an
# address on this host. HTTPS, because a client that refuses an insecure issuer
# is behaving correctly, and because WebAuthn requires a secure context.
SENTINEL_ISSUER=""

# The seeded administrator. Since S2 an organization's roster normally arrives
# over SCIM, but the first administrator has to exist before a connector can
# authenticate, so this is still the bootstrap identity. Change it from the
# shipped default before the provider is reachable by anyone else.
# SENTINEL_ADMIN_EMAIL="admin@example.com"

# Host port the provider is published on. Put it behind the platform's reverse
# proxy and certificate rather than exposing it directly.
ONTRAK_SENTINEL_HTTP_PORT="8787"

# WebAuthn defaults to SENTINEL_ISSUER, which is right for a provider serving
# its console from one name. A deployment serving several subdomains sets the
# registrable suffix here so every host under it may register a key.
# SENTINEL_WEBAUTHN_RP_ID="example"
