# OnTrak Sentinel — environment.
#
# Sentinel keeps its own database: it issues identity for the training app and
# for OnTrak Tix, but shares no tables with them, so one product's compromise is
# not another's evidence.

# The spine's database. Migrations live in `prisma/migrations` (the spine, then
# the OIDC grant rows) and are applied with `npm run db:deploy`.
#
# Setting it also makes `npm run serve` run over Postgres: identities, sessions,
# the evidence chain and the OIDC clients, codes and tokens all persist, so a
# restart keeps them. Unset, the same provider runs over in-memory stores for a
# quick look at the endpoints.
DATABASE_URL="postgresql://sentinel:sentinel@127.0.0.1:5434/sentinel"

# The seeded administrator `npm run serve` bootstraps (and reuses on restart).
# Defaults to admin@demo.test when unset; the example address below is a
# placeholder rather than a real mailbox.
SENTINEL_ADMIN_EMAIL="admin@example.com"

# The OIDC provider (`npm run serve`). The issuer is what a client checks an ID
# token's `iss` against, and it is the prefix every advertised endpoint gets.
SENTINEL_ISSUER="http://127.0.0.1:8787"
SENTINEL_HOST="127.0.0.1"
SENTINEL_PORT="8787"

# The RS256 signing key, as a PEM. Two ways to supply it, and which one is right
# depends on who is responsible for it:
#
#   SENTINEL_SIGNING_KEY        the PEM itself — what a deployment that resolves
#                               its secrets before the process starts hands over.
#                               It takes precedence over the file below.
#   SENTINEL_SIGNING_KEY_FILE   the path to that PEM. What the compose stack uses:
#                               a one-shot `signing-key` service generates one onto
#                               a volume on the first `up` and every later run reuses
#                               it, so restarting or rebuilding keeps signing with
#                               the key already published.
#
# Supply neither and the provider generates an ephemeral key, which is right for
# poking at the endpoints and wrong in a deployment: every ID token it has signed
# stops verifying the moment the process restarts, including ones a client has
# already cached a JWKS for. A file that is named but unreadable is an error rather
# than a fallback, on purpose.
# SENTINEL_SIGNING_KEY="<the PEM>"
# SENTINEL_SIGNING_KEY_FILE="/run/sentinel/signing-key.pem"
# SENTINEL_SIGNING_KID="sentinel-s1"

# Register a public OIDC client for OnTrak Tix, so the desk's `/admin/identity`
# page has a client id to configure. Opt-in: a provider should not register a
# client for a product nobody has pointed at it. Set this to the desk's callback —
# `ONTRAK_TIX_BASE_URL` plus `/api/sso/callback` — and it becomes the client's one
# registered redirect URI.
#
# It must be `https`, or `http` on a loopback address: a desk reached at a bare LAN
# address over plain HTTP cannot be registered at all, and is told so rather than
# quietly allowed.
# SENTINEL_TIX_CALLBACK="http://127.0.0.1:3001/api/sso/callback"

# WebAuthn (the console's "register a security key"). The origin is the page a
# ceremony runs on and is compared *exactly* against `clientDataJSON`, so it is
# the console's own address — scheme, host and port, with no trailing slash. The
# RP ID is a bare hostname (no scheme, port or path) that must cover that origin;
# it defaults to the origin's host, which is right for a provider serving its
# console from one name. A deployment serving several subdomains sets the
# registrable suffix here, and every host under it may register a key.
# Both default to `SENTINEL_ISSUER` when unset.
# SENTINEL_WEBAUTHN_ORIGIN="https://id.example"
# SENTINEL_WEBAUTHN_RP_ID="example"
