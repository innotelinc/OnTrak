# ═══════════════════════════════════════════════════════════════════════════
# OnTrak Bolt — the deployment's environment.
#
# `docker-compose.yml` reads `.env`; `docker-compose.prod.yml` reads this file.
# Same variables, and the difference is where the values come from: here the key
# is a vault reference, never a copied secret.
#
#   cp .env.production.example .env.production   # then fill it in
#
# then:
#
#   docker compose --env-file .env.production \
#     -f docker-compose.yml -f docker-compose.prod.yml up -d
# ═══════════════════════════════════════════════════════════════════════════

# The estate's model gateway (OpenAI-compatible; see `.env.example`).
OPENAI_LIKE_API_BASE_URL=https://gateway.innotel.us/v1

# Where the key lives, not what it is. The image's entrypoint resolves it against
# Cerulean Vault before the app boots.
OPENAI_LIKE_API_KEY=vault://cerulean/ontrak#OMNIROUTE_API_KEY

# The routes this deployment offers. On this estate the gateway lists 1,249 ids;
# these are the ones the family's coding turns actually use.
OPENAI_LIKE_API_MODELS=auto/best-coding:400000;auto/coding:200000;auto/best-reasoning:400000;auto/best-fast:200000

# Cerulean Vault. `VAULT_TOKEN_FILE` is the path the deployment mounts read-only.
VAULT_ADDR=http://192.168.1.71:8200
VAULT_TOKEN_FILE=/vault/token/ontrak.token
VAULT_PREFIX=cerulean

# The release to run. One tag for the family: a release publishes the same version
# for every product, so this is the same variable name the other overlays use.
ONTRAK_IMAGE_TAG=latest

# Where the console listens on the host (host networking, so this *is* the port).
ONTRAK_BOLT_PORT=3500
