# ═══════════════════════════════════════════════════════════════════════════
# OnTrak Bolt — environment.
#
#   cp .env.example .env      (then fill in the two values below)
#
# One model source, not thirty. The family runs its models behind **OmniRoute**,
# the same OpenAI-compatible gateway Genie, Engineer and the rest of the estate
# call (`https://gateway.innotel.us/v1`). Bolt talks to it through its
# "OpenAILike" provider, which means the deployment has one endpoint and one key
# to look after, and adding a model is a gateway change rather than a redeploy of
# this app.
#
# Upstream ships a section per vendor (Anthropic, Groq, Together, …). Those still
# work — set the key and the provider appears — but nothing here needs them, and a
# placeholder left in a file is worse than an absent line: `your_openai_api_key_here`
# is a key as far as the model picker is concerned, and it fails at the first token
# instead of at startup.
# ═══════════════════════════════════════════════════════════════════════════

# ── the model gateway ──────────────────────────────────────────────────────
# The OpenAI-compatible base URL. Bolt appends `/models` for discovery and
# `/chat/completions` for the turn, so this must end at `/v1` — no trailing slash.
OPENAI_LIKE_API_BASE_URL=https://gateway.innotel.us/v1

# The key for that gateway. A `vault://` reference is resolved by the image's
# entrypoint before the app starts (see `docker-entrypoint.sh`); a plain value is
# passed through unchanged, for a laptop with no vault.
#   OPENAI_LIKE_API_KEY=vault://cerulean/ontrak#OMNIROUTE_API_KEY
OPENAI_LIKE_API_KEY=

# Which models this deployment offers, `id:context-length` separated by `;`.
# Empty means "every id the gateway lists", which on this estate is 1,249 of them —
# a directory, not a picker, and most of those ids answer 401: a `~vendor/model` id
# needs that vendor's credential on the gateway. The `auto/*` routes are resolved by
# the gateway itself, and they are the pool Genie sends its turns to, so they are the
# default in the compose files; this line is that default written out.
# The context length is optional (default 8000) and is what the model is offered with:
# an OpenAI-style catalogue reports no context length at all, so every id it lists comes
# back at 8,000. A larger number in the catalogue still wins where one exists.
#   OPENAI_LIKE_API_MODELS=auto/coding:200000;auto/best-coding:200000;auto/best-chat:200000;auto/cheap:200000;auto/thrifty:200000
OPENAI_LIKE_API_MODELS=

# ── the client's address, for the rate limiter ────────────────────────────
# Every `/api/*` route rate limits per client and refuses the request when it cannot
# name one. The image's preview server stamps this header from the TCP peer on every
# request, so a client cannot forge it and the app can trust it. Compose sets it; a
# bare `pnpm dev` does not and does not need to. `x-real-ip` is the only value that
# is read.
# BUG_REPORT_TRUSTED_IP_HEADER=x-real-ip

# ── Cerulean Vault, when the key above is a reference ──────────────────────
# The same three settings every product in the family uses. `VAULT_TOKEN_FILE` is
# the path-scoped token the deployment mounts read-only; the compose file does
# that mount. With none of these set, a reference cannot be resolved and the
# container refuses to start — deliberately, rather than booting with the literal
# string `vault://…` as its credential.
# VAULT_ADDR=http://192.168.1.71:8200
# VAULT_TOKEN_FILE=/vault/token/ontrak.token
# VAULT_PREFIX=cerulean

# ── where it listens ───────────────────────────────────────────────────────
# The container image sets both; a bare `pnpm dev` picks its own defaults.
# HOST=0.0.0.0
# PORT=5173

# ── the name it is served at ────────────────────────────────────────────────
# `vite preview` answers 403 to a Host it was not told about, so a deployment
# reached by name has to name it. The service name the sign-in proxy dials is always
# allowed; this variable adds the public one, comma-separated for more than one.
#   PREVIEW_ALLOWED_HOSTS=bolt.ontrak.technology
# PREVIEW_ALLOWED_HOSTS=

# ── the built app, served by this one ─────────────────────────────────────
# Bolt serves the app it builds inside a WebContainer in the browser, so there is
# no preview host, no sandbox container and no port to publish for it — unlike
# Genie, which runs the app it writes. Nothing to configure here.
#
# It does need to be reached over **HTTPS** (or `localhost`): a WebContainer needs
# `SharedArrayBuffer`, which needs a cross-origin isolated page, which only exists
# in a secure context.
