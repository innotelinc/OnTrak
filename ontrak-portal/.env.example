[TEMPLATE]
# OnTrak Portal — environment template. Copy to `.env` and fill in.
#
# Never commit `.env` — it is gitignored and local-only. This file IS the template
# and is committed.
#
# The portal holds no data of its own: no database, no migrations, no user table.
# It decides *where to send somebody* and then hands them to a product that checks
# them again. That is why almost everything below is an address or a secret rather
# than a setting.

# ── the family's names ──────────────────────────────────────────────────────
# The base domain every product address is built from:
#   <host>.<base domain>       its.|tix.|sentinel.|sync.ontrak.innotel.us
# It is also what the tiles print, so it has to be the name that actually resolves
# from the person's browser.
ONTRAK_PORTAL_BASE_DOMAIN=ontrak.innotel.us

# THIS portal, as the browser reaches it. The OIDC redirect URI is built from it
# (`<public url>/api/sso/callback`) and Cerulean has to be registered with exactly
# that string — a URI built from the container's own address can never match, which
# is the single most common reason SSO "just does not work".
ONTRAK_PORTAL_PUBLIC_URL=https://ontrak.innotel.us

# ── REQUIRED: the cookie signing secret ────────────────────────────────────
# There is no default. A session cookie signed with a placeholder is a session
# cookie anybody can mint. Generate with: openssl rand -hex 32
ONTRAK_PORTAL_SESSION_SECRET=

# ── Cerulean single sign-on (Authentik) ────────────────────────────────────
# All optional: a portal that names no provider simply shows no SSO button,
# because a button that cannot complete a handshake is worse than none. The names
# are the ones the training app and OnTrak Sync already use, so one snippet
# configures every product in the family.
ONTRAK_OIDC_ISSUER=https://auth.cerulean.innotel.us/application/o/ontrak
ONTRAK_OIDC_CLIENT_ID=ontrak
ONTRAK_OIDC_CLIENT_SECRET=
ONTRAK_OIDC_PROVIDER_NAME=Cerulean
ONTRAK_OIDC_SCOPES=openid profile email groups
ONTRAK_OIDC_DEFAULT_ROLE=STUDENT
# One `authentik-group=ROLE` per line or comma-separated. Written on ONE line here
# because a multi-line value is not portable: compose, `docker run --env-file` and
# a shell that sources the file do not agree about how to continue one, and a
# setting that only works for two of the three readers is a setting that will
# surprise somebody. The parser accepts `\n` and `,` equally.
#
# Valid roles: ADMIN SYSADMIN ANALYST TECHNICIAN INSTRUCTOR STUDENT. A rule whose
# role is not one of those is dropped rather than guessed at — a typo that silently
# granted ADMIN would be worse than a typo that grants nothing.
ONTRAK_OIDC_ROLE_MAPPINGS=ontrak-students=STUDENT,range-instructors=INSTRUCTOR,ontrak-desk=TECHNICIAN,ontrak-analysts=ANALYST,ontrak-sysadmins=SYSADMIN,ontrak-admins=ADMIN
# Restrict sign-in to these mail domains. Empty means "any domain the provider
# vouches for", which is right when the provider is the Network's own directory.
ONTRAK_OIDC_ALLOWED_DOMAINS=

# ── OnTrak Sync, the family's local account table ──────────────────────────
# The portal has no accounts of its own: a password sign-in is handed to OnTrak
# Sync, which owns the local user record and decides the role. This is the service
# address on the compose network, NOT the public one.
ONTRAK_SYNC_API_URL=http://ontrak-sync-api:8420

# ── the break-glass account (optional) ─────────────────────────────────────
# Disabled unless BOTH are set. It exists because the honest failure mode of a
# portal whose only sign-in is an identity provider is that the provider being down
# takes the portal with it — the same reason the DNS console keeps a local login,
# since DNS is what resolves the IdP. It grants ADMIN, it is compared in constant
# time, and every use is logged. Leave both unset for a deployment where Cerulean
# is always reachable.
ONTRAK_PORTAL_ADMIN_USER=
ONTRAK_PORTAL_ADMIN_PASSWORD=

# ── per-product liveness probes (optional) ─────────────────────────────────
# The tile's status light asks each product's own unauthenticated health endpoint.
# The public name is used by default; set an internal address when the public one
# is not reachable from inside the container (hairpin NAT, or a certificate the
# container does not trust). Probing an internal address never changes what the
# browser is told to open.
# ONTRAK_ITS_INTERNAL_URL=http://training-app:3000
# ONTRAK_TIX_INTERNAL_URL=http://tix-app:3001
# ONTRAK_SENTINEL_INTERNAL_URL=http://sentinel-app:8787
# ONTRAK_SYNC_INTERNAL_URL=http://ontrak-sync-api:8420
# ONTRAK_GENIE_INTERNAL_URL=http://genie-app:3400

# ── Cerulean Vault (SecretOps) ─────────────────────────────────────────────
# The platform's secret store is Cerulean Vault (HashiCorp Vault, KV v2). Any
# value above may be a `vault://<mount>/<path>#<key>` reference instead of plain
# text; the image's entrypoint (docker-entrypoint.sh) resolves them before the
# server boots, so the application reads the plain value from its environment and
# never knows a reference was there. A reference that cannot be resolved —
# unreachable Vault, missing path, wrong key — stops the container instead of
# booting with a literal `vault://` string or a stale credential.
#
# The platform mints one path-scoped token per product (Cerulean's
# VAULT_PRODUCT_TOKENS): the portal's covers cerulean/data/ontrak and nothing
# else, so a leaked copy cannot read a sibling's secrets. The entrypoint reads it
# from the file mounted at /vault/token/ontrak.token (see docker-compose.yml).
#
# Leave VAULT_ADDR empty to keep everything plain-text (the resolver is then a
# no-op); set it to switch the references on.
VAULT_ADDR=
VAULT_TOKEN_FILE=
# KV v2 mount point. Cerulean's default is `cerulean`; only change it for an
# external Vault mounted elsewhere.
VAULT_PREFIX=cerulean
# Enterprise namespaces and TLS knobs; all unused on the platform's OSS Vault.
VAULT_NAMESPACE=
VAULT_SKIP_VERIFY=
VAULT_CACERT=
#
# Example: move this deployment's secrets and reference them
#   python3 scripts/vault-migrate.py --from-env-file .env --keys \
#     ONTRAK_PORTAL_SESSION_SECRET,ONTRAK_OIDC_CLIENT_SECRET,ONTRAK_SYNC_API_TOKEN
# then set the values to references:
#   ONTRAK_PORTAL_SESSION_SECRET=vault://cerulean/ontrak#ONTRAK_PORTAL_SESSION_SECRET
