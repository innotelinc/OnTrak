# OnTrak Tix — copy to .env and fill in.

# PostgreSQL connection. The tix database is separate from the training app's.
# Running from source, this is the address of the container `npm run docker:db`
# starts. Inside `docker compose up` the app is given the equivalent URL for the
# stack's own `db` service instead — this value is not used there.
DATABASE_URL="postgresql://ontrak:ontrak@127.0.0.1:5432/ontrak_tix"

# Host port the compose stack publishes its database on. The training app also
# defaults to 5432 and Sentinel publishes its own database on 5434, so the three
# stacks are 5432 / 5433 / 5434 by convention here. Uncommented, because a desk
# and a training app running at the same time is the normal case, not the
# exception — leaving both on 5432 makes the second one refuse to start.
ONTRAK_TIX_DB_PORT="5433"

# Session signing key (at least 16 characters). Falls back to AUTH_SECRET.
TIX_AUTH_SECRET="change-me-to-a-long-random-string"

# Session lifetime in seconds (default 7 days).
TIX_SESSION_TTL_SECONDS="604800"

# Whether the session cookie is marked `Secure` (TLS-only). Default `auto`
# follows the request: the cookie is restricted when the request arrives over
# https (directly or as `X-Forwarded-Proto: https` from a TLS terminator), and
# is not restricted otherwise. That default exists because a browser refuses to
# store a `Secure` cookie from an insecure origin, everywhere but `localhost` —
# so a plain-HTTP deployment that hard-codes the flag signs everyone in on the
# machine it runs on and silently signs everyone else out. Set `always` behind a
# terminator that does not report the scheme, or `never` for a deployment whose
# TLS is handled elsewhere entirely. Accepts always|never|true|false|1|0|yes|
# no|on|off; anything else means `auto`.
# TIX_COOKIE_SECURE="auto"

# Set to "true" to let inbound email open or append tickets.
ONTRAK_TIX_EMAIL_INGESTION="false"

# Shared secret for the inbound-email webhook (`POST /api/intake/email`).
# The provider signs deliveries with it; the route fails closed when it is unset.
ONTRAK_TIX_WEBHOOK_SECRET=""

# Shared secret for the RMM / monitoring webhook (`POST /api/rmm`). The
# monitoring system signs deliveries with it and the route fails closed when it
# is unset. Deliberately its own secret rather than the inbound-email one: two
# integrations on one secret means rotating either breaks both, and a monitoring
# system is exactly the caller somebody replaces.
ONTRAK_TIX_RMM_SECRET=""

# Who a monitoring alert's ticket is raised for. A check that fails has nobody
# behind it, so the work is filed for this mailbox when it is set, and for the
# tenant's first active administrator when it is not. A tenant with neither gets
# a 503, because filing an outage against a user that does not exist is worse.
# ONTRAK_TIX_RMM_REQUESTER_EMAIL="monitoring@acme.test"

# This deployment's own address. Two things depend on it, and both fail in ways
# that do not look like configuration:
#
#   * the "Open in OnTrak Tix" link in a Slack or Teams notification — unset, the
#     message is sent without a link, which is deliberate, since a button pointing
#     at a host we invented is worse than no button;
#   * the single sign-on handshake. A redirect URI is matched *exactly* against the
#     one the provider registered, and without this the desk builds it from the
#     address it is bound to — inside a container, `0.0.0.0:3000` — so the provider
#     refuses the handshake with a redirect-URI mismatch and the post-sign-in
#     redirect strands the browser. It must agree with the redirect URI registered
#     on the provider. No trailing slash needed.
# ONTRAK_TIX_BASE_URL — auto-detected by `make lan` from this host's LAN IP
# (set to auto, make lan writes ONTRAK_TIX_BASE_URL=http://<LAN_IP>:3001 to .env).
# Set explicitly to override.

# The workspace the sign-in page's SSO button uses when nobody types one. Leave it
# unset for a multi-tenant install, where the slug is what tells one desk's people
# from another's; set it to the single desk's slug for a deployment that only has
# one, so the button is not a question only an administrator can answer.
# ONTRAK_TIX_DEFAULT_TENANT="acme"

# What the identity provider calls itself on the sign-in screen. Shared with the
# rest of the family, so one deployment can rename the provider everywhere at once.
# ONTRAK_OIDC_PROVIDER_NAME="Cerulean"

# The break-glass door at `/sign-in/break-glass`: a local account that works when the
# provider does not. It is on by default and unlinked, because a fallback nobody can
# reach is not a fallback. Set this to `0` to close it, which is what a deployment
# that has no local accounts seeded should do.
# ONTRAK_TIX_ALLOW_LOCAL_SIGN_IN="1"

# --- Outbound provisioning (SCIM) -------------------------------------------
# Where the desk pushes its people: the identity provider's origin, and a
# connector token minted in that provider's console (in OnTrak Sentinel:
# `/console/provisioning`, shown once and hashed at rest). With both set,
# `/admin/identity` gains a "Push accounts to the provider" button; with neither,
# the page says the deployment is not configured rather than offering the button.
# Half-set is refused, and reported on that page.
#
# The endpoint is server-to-server, so in a container stack it is the *service*
# name and never `localhost` — from in here that address is the desk itself.
# ONTRAK_TIX_SCIM_BASE_URL="http://sentinel:8787"
# ONTRAK_TIX_SCIM_TOKEN="sc1_..."

# Directory for attachment bytes in local/single-node deployments. Multi-instance
# deployments point the `BlobStore` port at object storage instead.
ONTRAK_TIX_BLOB_DIR=".ontrak-tix-blobs"

# Where incident evidence artifacts are stored, under object-lock retention
# (write-once, then kept for the evidence retention window). Point this at an
# object-locked bucket in production — see docs/incidents.md.
ONTRAK_TIX_EVIDENCE_DIR=".ontrak-tix-evidence"

# Default retention mode for stored evidence artifacts. `COMPLIANCE` (the
# default) cannot be removed early by anyone, not even an administrator;
# `GOVERNANCE` is locked for the same window but an administrator may remove it
# early, on the record. See `src/lib/object-lock-rules.ts`.
ONTRAK_TIX_EVIDENCE_LOCK_MODE="COMPLIANCE"

# Key the signed Assurance Packet (`GET /api/incidents/<id>/packet`) is signed
# with. Falls back to TIX_AUTH_SECRET, but a deployment that hands packets to
# insurers or auditors should set its own — anyone with this key can mint a
# packet that verifies.
ONTRAK_TIX_ASSURANCE_SECRET=""
# Shared secret a scheduler signs the scheduled endpoints with
# (`POST /api/sla/sweep` raises escalations; `POST /api/sla/report` snapshots
# the weekly report into the audit chain; `POST /api/incidents/retention-sweep`
# purges artifacts whose object-lock window has closed — all
# `Authorization: Bearer …`). A sweep can also be run without HTTP as
# `npm run sweep:retention`.
# Falls back to ONTRAK_TIX_WEBHOOK_SECRET, and fails closed when neither is set.
ONTRAK_TIX_CRON_SECRET=""

# --- Closing the loop (M7) ---------------------------------------------------
# When a ticket is resolved, the outcome sweep writes a knowledgebase article and
# hands a practice scenario to OnTrak ITS (`POST /api/outcomes/sweep`, one of the
# `ONTRAK_TIX_CRON_SECRET` endpoints). `?dry=1` authors the drafts and reports them
# without writing anything, which is how a deployment decides whether the prose is
# good enough to switch on.
#
# THE WRITER. Any OpenAI-compatible chat-completions endpoint. The defaults point at
# OmniRoute — the self-hosted gateway that pools providers (free tiers included) behind
# one endpoint at 127.0.0.1:20128/v1 — because that is software this Network runs
# rather than an account somebody has to keep paying for.
#
#   OmniRoute on this host   ONTRAK_AI_ENABLED="1"            # no key needed; model "auto"
#   OmniRoute on another box ONTRAK_AI_BASE_URL="http://omniroute.lan:20128/v1"
#   an OpenAI-compatible service  ONTRAK_AI_API_KEY="sk-…"  and set the base URL
#   a vLLM box / Ollama / LiteLLM set the base URL and (usually) no key
#
# With no key and no explicit switch the deterministic author writes the draft instead
# — from the transcript, inventing nothing — so the loop works with no model at all,
# and a laptop or an air-gapped box does not pay a connection timeout per ticket. The
# model only makes the prose read better.
# ONTRAK_AI_API_KEY=""
# ONTRAK_AI_BASE_URL="http://127.0.0.1:20128/v1"
# ONTRAK_AI_MODEL="auto"
# 1 = use the model even with no key (what a keyless local OmniRoute needs).
# 0 = keep the key but stop sending tickets to a model.
# ONTRAK_AI_ENABLED="1"
# ONTRAK_AI_TIMEOUT_MS="20000"
#
# NOTE: OmniRoute's own `auto` combo means OmniRoute chooses the provider, so a
# specific model belongs here only when a deployment needs to pin one.

# WHERE THE SCENARIO GOES. Both are required; half-set is reported as not
# configured rather than almost working. The token is minted on the range
# (`ONTRAK_ITS_SERVICE_TOKEN` there must match). In a container stack the host is
# the service name — from in here, `localhost` is the desk.
# ONTRAK_ITS_BASE_URL="http://ontrak-training-app:3000"
# ONTRAK_ITS_SERVICE_TOKEN=""
