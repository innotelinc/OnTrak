{
  "name": "ontrak-tix",
  "version": "0.1.0",
  "private": true,
  "description": "OnTrak Tix — enterprise ticketing and service management for IT desks and MSPs. An Innotel Labs product.",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "copy:check": "node scripts/copy-check.mjs",
    "test": "tsx --tsconfig tests/tsconfig.json --test tests/*.test.ts",
    "check": "npm run typecheck && npm run copy:check && npm test",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "verify:packet": "tsx scripts/verify-packet.ts",
    "sweep:retention": "tsx scripts/retention-sweep.ts",
    "sweep:scim": "tsx scripts/scim-sweep.ts",
    "setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "docker:db": "docker compose up -d db"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "jose": "^6.0.10",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.17",
    "@types/node": "^22.13.14",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "prisma": "^6.5.0",
    "tailwindcss": "^4.0.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
