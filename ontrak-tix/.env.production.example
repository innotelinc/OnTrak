[TEMPLATE]
# ---------------------------------------------------------------------------
# OnTrak Tix — production configuration.
#
# Copy to `.env.production` and fill it in:
#
#     cp .env.production.example .env.production
#     make tix-prod-up
#
# `.env.production` is gitignored and must never be committed — this template
# carries placeholders only, never a real value.
#
# The overlay `docker-compose.prod.yml` refuses to start without the two
# REQUIRED values below, because the development placeholders in `.env` are
# public knowledge and a deployment that quietly accepted them would be worse
# than one that stopped.
#
# In a stack deployment these are Cerulean Vault references the deployment
# resolves before the app starts (`vault://<mount>/<path>#<key>`), not literals.
# ---------------------------------------------------------------------------

# REQUIRED — signs every desk session. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
TIX_AUTH_SECRET=""

# REQUIRED — the password the Postgres role is created with. Note that changing
# it later does not change an existing database's password: that needs
# `ALTER USER ontrak WITH PASSWORD ...` against the running database.
POSTGRES_PASSWORD=""

# Session lifetime in seconds (default 7 days).
TIX_SESSION_TTL_SECONDS="604800"

# --- The scheduled endpoints -------------------------------------------------
# Shared secret the scheduler signs the sweep endpoints with. Falls back to the
# webhook secret and fails closed when neither is set, so a deployment that
# wants its SLA escalations, report snapshots and retention purges to run must
# set this.
ONTRAK_TIX_CRON_SECRET=""

# --- Inbound email -----------------------------------------------------------
# The provider signs deliveries with this; the route fails closed when unset, so
# leaving it empty and the ingestion flag off is a valid choice.
ONTRAK_TIX_EMAIL_INGESTION="false"
ONTRAK_TIX_WEBHOOK_SECRET=""

# --- Assurance packets -------------------------------------------------------
# Key the signed Assurance Packet is signed with. Falls back to TIX_AUTH_SECRET,
# but a deployment that hands packets to insurers or auditors should give it its
# own: anyone holding this key can mint a packet that verifies.
ONTRAK_TIX_ASSURANCE_SECRET=""

# --- Evidence retention ------------------------------------------------------
# `COMPLIANCE` cannot be removed early by anyone, not even an administrator.
ONTRAK_TIX_EVIDENCE_LOCK_MODE="COMPLIANCE"

# --- Serving -----------------------------------------------------------------
# Host port the app is published on. Put it behind the platform's reverse proxy
# and certificate rather than exposing it directly.
ONTRAK_TIX_HTTP_PORT="3001"
