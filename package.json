{
  "name": "ontrak-it-support-training",
  "version": "0.1.0",
  "private": false,
  "description": "OnTrak IT Support Training — an open source, browser-based IT support training platform with gradable Linux, Windows and Office simulations. An Innotel Labs product.",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --tsconfig tests/tsconfig.json --test tests/*.test.ts",
    "test:a11y": "playwright test",
    "test:e2e:tix": "ONTRAK_TIX_BASE_URL=${ONTRAK_TIX_BASE_URL:-http://127.0.0.1:3001} playwright test tests/browser/tix.spec.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset-demo": "tsx prisma/reset-demo.ts",
    "db:studio": "prisma studio",
    "theme:verify": "python3 theme/tests/test_theme_copies.py",
    "setup": "prisma generate && prisma migrate deploy && tsx prisma/reset-demo.ts && tsx prisma/seed.ts",
    "docker:db": "docker compose up -d db"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "jose": "^6.0.10",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.0.17",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.13.14",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "axe-core": "^4.10.2",
    "jsdom": "^25.0.1",
    "prisma": "^6.5.0",
    "tailwindcss": "^4.0.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
