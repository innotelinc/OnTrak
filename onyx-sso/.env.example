# ONYX's sign-in — oauth2-proxy in front of the storage console (onyx.innotel.us).
#
# These are **references**, not values: every credential this proxy needs lives in
# Cerulean Vault (HashiCorp Vault, KV v2) at `cerulean/ontrak/onyx-sso`, in the estate's
# `vault://<mount>/<path>#<key>` form. `scripts/deploy.sh` resolves them into the
# environment `docker-compose.all.yml` interpolates, because oauth2-proxy is a stock
# image: its entrypoint is the proxy itself, so unlike this repo's own images there is
# nothing inside the container to resolve a reference before the config is read.
#
#   cp onyx-sso/.env.example onyx-sso/.env      # once per deployment
#   GENIE_SMOKE_ACTOR=you@example.com make all-up
#
# A deployment that already had `onyx-sso/.env` with plaintext values can move them
# into the vault and rewrite the file with the references below:
#
#   VAULT_ADDR=http://192.168.1.71:8200 VAULT_PREFIX=cerulean \
#   VAULT_TOKEN=$(cat data/vault/token/ontrak.token) \
#     python3 ../platform-stack/scripts/vault-migrate.py \
#       --from-env-file onyx-sso/.env --path ontrak/onyx-sso
#
# The values are the family's own `ontrak` OIDC client — the same one G0DM0D3's and
# Engineer's proxies use — so one sign-in covers the console and this page. Rotating
# the client in Authentik means writing the new secret to the vault path and recreating
# this one container; nothing in this file changes.

OAUTH2_PROXY_CLIENT_ID=vault://cerulean/ontrak/onyx-sso#OAUTH2_PROXY_CLIENT_ID
OAUTH2_PROXY_CLIENT_SECRET=vault://cerulean/ontrak/onyx-sso#OAUTH2_PROXY_CLIENT_SECRET
OAUTH2_PROXY_COOKIE_SECRET=vault://cerulean/ontrak/onyx-sso#OAUTH2_PROXY_COOKIE_SECRET
