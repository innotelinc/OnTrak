{
  "name": "OnTrak IT Support Training — hands-on IT support training",
  "short_name": "OnTrak Training",
  "description": "Practice real IT support work: graded Linux, Windows and Office scenarios in the browser, timed and working on any device.",
  "id": "/",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f7f5ff",
