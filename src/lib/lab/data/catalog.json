  "windows-desktop.yaml": {
    "defaults": {
      "family": "windows",
      "kind": "vm",
      "resources": {
        "cpu": 2,
        "disk": "48GiB",
        "memory": "4GiB"
      },
      "scenario_families": [
        "hardware",
        "software",
        "network",
        "os",
        "security"
      ]
    },
    "description": "Every Windows desktop release from Windows 95 to Windows 11. Builders: `incus-windows` drives the unattended install used for Windows 10/11 (virtio, WinRM, the Incus agent); `answer-file` renders our own autounattend.xml for Vista-8.1 and XP/2000; `manual` means the operator installs once by hand and publishes the image \u2014 unavoidable before Windows 2000, which has no answer-file automation worth relying on.\n",
    "entries": [
      {
        "automation": "none",
        "device_profile": "legacy-9x",
        "id": "win95-osr2",
        "install": {
          "builder": "manual",
          "recipe": "manual"
        },
        "media": {
          "filename": "win95-osr2.iso",
          "kind": "iso",
          "notes": "Retail/OEM media; the publisher no longer distributes it.",
          "source": "operator"
        },
        "name": "Windows 95 OSR2",
        "notes": "Needs a real IDE/PCI-era device profile and a FAT16 disk under 2 GB. No guest automation exists, so scenarios on this platform are instructor-observed: Device Manager conflicts, Control Panel, config.sys/autoexec.bat editing.\n",
        "released": "1996-08",
        "resources": {
          "cpu": 1,
          "disk": "4GiB",
          "memory": "256MiB"
        },
        "support": "eol",
        "tags": [
          "dos-era",
          "legacy-hardware"
        ]
      },
      {
        "automation": "none",
        "device_profile": "legacy-9x",
        "id": "win98se",
        "install": {
          "builder": "manual",
          "recipe": "manual"
        },
        "media": {
          "filename": "win98se.iso",
          "kind": "iso",
          "source": "operator"
        },
        "name": "Windows 98 Second Edition",
        "notes": "Good for driver-conflict and startup-configuration exercises. Grading is manual.",
        "released": "1999-05",
        "resources": {
          "cpu": 1,
          "disk": "8GiB",
          "memory": "256MiB"
        },
        "support": "eol",
        "tags": [
          "dos-era",
          "legacy-hardware"
        ]
      },
      {
        "automation": "none",
        "device_profile": "legacy-9x",
        "id": "win-me",
        "install": {
          "builder": "manual",
          "recipe": "manual"
        },
        "media": {
          "filename": "winme.iso",
          "kind": "iso",
          "source": "operator"
        },
        "name": "Windows Millennium Edition",
        "notes": "The first consumer Windows with System Restore, which makes it the classic \"roll back a bad driver\" scenario. No automation; grading is manual.\n",
        "released": "2000-09",
        "resources": {
          "cpu": 1,
          "disk": "8GiB",
          "memory": "512MiB"
        },
        "support": "eol",
        "tags": [
          "dos-era",
          "system-restore"
        ]
      },
      {
        "automation": "none",
        "device_profile": "legacy-xp",
        "edition": "SP6a",
        "id": "win-nt4-workstation",
        "install": {
          "builder": "manual",
          "recipe": "manual"
        },
        "media": {
          "filename": "winnt4wks-sp6a.iso",
          "kind": "iso",
          "source": "operator"
        },
