# --- Web server ---
# The port the server binds when you run it yourself (`npm start`). The compose
# stack in this directory overrides it from `ONTRAK_GENIE_PORT` (default 3410),
# because the family stack is the owner of :3400 — see docker-compose.yml.
PORT=3400
# 127.0.0.1 keeps the UI private. If you bind 0.0.0.0 (or a LAN address) you MUST
# also set WEB_TOKEN: anyone who can reach the port can read, edit and run code.
HOST=127.0.0.1

# --- Model gateway ---
# An OpenAI-compatible gateway. Its "auto/*" ids route across whatever providers
# it has connected, so this works with no key of its own.
#
# Address it by a routable host, not a Docker service name: a container in a
# compose file is only reachable at a bridge address like 172.17.x.x, which no
# other host on the network can resolve or route to. A deployment points this at
# the stack's shared OmniRoute, and that address is supplied at deploy time (or as
# a `vault://` reference) — no internal address belongs in a repo file. The
# loopback default below is what a gateway on this host answers on.
OMNIROUTE_URL=http://127.0.0.1:20128/v1
# Only needed if the gateway requires auth. On a deployment this is a Cerulean
# Vault reference, not the key itself — see "Cerulean Vault" below:
#   OMNIROUTE_API_KEY=vault://cerulean/ontrak#OMNIROUTE_API_KEY
OMNIROUTE_API_KEY=
#
# To run your own gateway instead, start one (`npm run gateway`) and either use
# http://127.0.0.1:20128/v1 on this host, or connect another provider to it:
#   npm run provider:add -- --name Groq \
#     --base-url https://api.groq.com/openai/v1 --api-key gsk_... --prefix groq

# Optional — the gateway's browser-facing address, used only in the one message
# that sends a human to it ("connect another provider at …"). `OMNIROUTE_URL` is
# what *this process* dials, which on a deployment is a LAN address a browser
# cannot open, and whose callback the gateway's own SSO provider may not have
# registered. Set the gateway's public address so the instruction works:
#   AGENT_GATEWAY_CONSOLE_URL=https://gateway.studio.innotel.us
# Empty means the dialled address with any trailing /v1 removed.
AGENT_GATEWAY_CONSOLE_URL=

# --- Agent ---
# Any model with tool calling works. Pin an explicit id rather than an "auto/*"
# combo: combo names describe intent, not capability, and a combo that cannot
# reach a tool-calling model fails the whole turn (the gateway answers
# "No target in combo ... supports tool calling"). Check a candidate first -
# a large advertised catalog is not the same as a usable one.
#
# The default is the gateway's own `auto/*` routes rather than pinned model ids,
# because a curated list is only as available as the credentials behind it: when
# the providers a list is drawn from all go dark at once, every entry fails its
# probe together (the sidebar then reads "models 0/5 ready"). `auto/*` is resolved
# per request across whatever credentials are live, so a fixed entry keeps
# working while a provider is switched off. `auto/coding` is the route for this
# product's job; `auto/thrifty` is the last resort.
AGENT_MODEL=auto/coding
# Directory the agent is allowed to read and write. Nothing outside it is reachable.
# Running under `docker compose` these two are overridden to /workspace and /data,
# which are the paths inside the image (a bind mount and a named volume).
AGENT_WORKSPACE=./workspace
# Also holds sweep.json, the last finished catalog sweep, so the report survives a
# restart (and, in the container, lives in the agent-data volume).
AGENT_DATA_DIR=./.agent
# Tried in order when the chosen model throttles, errors, or answers with
# nothing - routine on free tiers. Comma-separated; keeps a turn from dying
# mid-task. Empty when you only trust one model. This is only the *default*: the
# UI's "chain" box overrides it per chat, and clearing that box means "nothing
# else", not "go back to this list".
AGENT_FALLBACK_MODELS=auto/best-coding,auto/best-chat,auto/thrifty
# --- Free accounts: the automatic pool (optional) ---
# An account whose plan the control plane reports as free is *served* a model
# rather than choosing one, and the UI hides the model picker and the chain box.
# The pool below is ordered by reliability - the model whose credentials are
# least likely to be cooling down leads - and is filtered by the chain-health
# check before each turn, so a model that returned a 429 last check moves behind
# one that answered. That is what removes the "429 ... retrying with ..." notices
# from a free account: the turn opens on a model the probe could get a tool call
# out of, instead of on whichever id is first in a file. Comma-separated ids.
AGENT_FREE_MODELS=auto/coding,auto/best-coding,auto/best-chat,auto/cheap,auto/thrifty
# Plan names that count as free, matched case-insensitively. Anything else is
# treated as paid and keeps the picker; the control plane's own default for an
# account with no plan is the string "free".
AGENT_FREE_PLANS=free,trial,community
# Take the picker away from everybody, paid or not. For a deployment that does
# not want the choice offered at all. Default false.
AGENT_FORCE_AUTO_MODEL=false
# Max assistant turns per user message. The UI's "steps" box overrides this for
# a chat, and the request can override it again for a single turn.
AGENT_MAX_STEPS=30
AGENT_COMMAND_TIMEOUT_MS=120000
AGENT_REQUEST_TIMEOUT_MS=300000
# Stream tokens to the browser. Set false if a provider mishandles SSE.
AGENT_STREAM=true

# --- Chain health (optional) ---
# How often the server asks whether each model in the chain can still make a tool
# call. The answer shows in the sidebar as "models n/m ready", which is the
# difference between finding out now and finding out mid-task. Only the chain is
# probed - never the whole catalog, which would take minutes and rate-limit the
# providers it is measuring. 0 disables it.
AGENT_HEALTH_INTERVAL_MS=900000

# When *every* model in the chain comes back throttled and the turn has produced
# nothing yet (no text, no tool call), wait and then walk the chain again instead
# of failing the turn - a cooling-down credential is worth outlasting. It is only
# ever applied before any tool has run, so a re-walk cannot repeat work. The wait
# doubles per attempt, capped at a minute. 0 disables it.
AGENT_RETRY_ATTEMPTS=2
AGENT_RETRY_DELAY_MS=20000

# --- Offline fallback (optional) ---
# A second, independent gateway tried only after every model above has failed.
# Point it at a model server on this machine so the agent still works with no
# internet - and when the primary gateway itself is unreachable. Ollama serves an
# OpenAI-compatible API at /v1 and needs no key:
#   ollama pull qwen2.5-coder:7b
# The endpoint is reached from this host, so the default loopback bind is enough;
# OLLAMA_HOST=0.0.0.0 is only needed if something off-box must reach it too.
# When it answers, the UI shows an "offline: <model>" badge in the toolbar, and
# the toolbar's "local" checkbox lets a single chat opt out of it. Leave
# AGENT_OFFLINE_URL empty to disable the whole thing.
AGENT_OFFLINE_URL=
AGENT_OFFLINE_KEY=
AGENT_OFFLINE_MODELS=

# --- Cerulean Vault (SecretOps) ---------------------------------------------
# The platform's secret store is Cerulean Vault (HashiCorp Vault, KV v2). Any
# value above or below may be a `vault://<mount>/<path>#<key>` reference instead
# of plain text; the image's entrypoint (docker-entrypoint.sh) resolves them
# before the server boots, so the application reads the plain value from its
# environment and never knows a reference was there. A reference that cannot be
# resolved — unreachable Vault, missing path, wrong key — stops the container
# instead of booting with a literal `vault://` string or a stale credential.
#
# The platform mints one path-scoped token per product (Cerulean's
# VAULT_PRODUCT_TOKENS): Genie's covers cerulean/data/ontrak and nothing else, so
# a leaked copy cannot read a sibling's secrets. On the family deployment the
# entrypoint reads it from the file mounted at /vault/token/ontrak.token.
#
# Leave VAULT_ADDR empty to keep everything plain-text (the resolver is then a
# no-op); set it to switch the references on.
VAULT_ADDR=
VAULT_TOKEN_FILE=
# KV v2 mount point. Cerulean's default is `cerulean`; only change it for an
# external Vault mounted elsewhere.
VAULT_PREFIX=cerulean
# Enterprise namespaces and TLS knobs; all unused on the platform's OSS Vault.
VAULT_NAMESPACE=
VAULT_SKIP_VERIFY=
VAULT_CACERT=
#
# Example: move this deployment's secrets and reference them
#   python3 scripts/vault-migrate.py --from-env-file .env \
#     --keys OMNIROUTE_API_KEY,CONTROL_INTERNAL_TOKEN,ONTRAK_OIDC_CLIENT_SECRET,ONTRAK_OIDC_SESSION_SECRET
# then set, in this file:
#   OMNIROUTE_API_KEY=vault://cerulean/ontrak#OMNIROUTE_API_KEY
#   CONTROL_INTERNAL_TOKEN=vault://cerulean/ontrak#CONTROL_INTERNAL_TOKEN
#   ONTRAK_OIDC_CLIENT_SECRET=vault://cerulean/ontrak#ONTRAK_OIDC_CLIENT_SECRET
#   ONTRAK_OIDC_SESSION_SECRET=vault://cerulean/ontrak#ONTRAK_OIDC_SESSION_SECRET

# --- Approval gate ---
# "risky" (recommended) = every run_command, plus writes that change more than
# AGENT_APPROVAL_MAX_LINES lines, wait for a click in the browser. "all" = every
# writing tool. "off" = never ask, which is what API clients driving the endpoint
# directly will want. Note the offline fallback is not exempt: a local model asks
# for approval exactly like a remote one.
AGENT_APPROVAL=off
AGENT_APPROVAL_MAX_LINES=200
AGENT_APPROVAL_TIMEOUT_MS=300000

# --- Command sandbox ---
# Where run_command executes. "auto" uses the container built by
# `npm run sandbox:build` when Docker is available, "docker" refuses to fall back
# to running on the host, "host" runs unisolated (use this inside docker compose,
# where the agent container is already the boundary).
AGENT_SANDBOX=auto
# Whether a sandboxed command may reach the network. "none" (default) is the
# promise the sandbox makes; "bridge" lets the agent fetch its own dependencies
# (`pip install`, `npm install`, `apt`, `curl`), which a real project often needs
# and which "none" makes impossible. "host" shares Genie's own network namespace,
# which is what a deployment that publishes the preview wants: a sandboxed
# command then holds the deployment's LAN address rather than a `172.x` bridge
# address. Set it deliberately.
AGENT_SANDBOX_NETWORK=none
AGENT_SANDBOX_IMAGE=coding-agent-sandbox:latest
AGENT_SANDBOX_MEMORY=2g
AGENT_SANDBOX_CPUS=2
AGENT_SANDBOX_PIDS=512

# --- Previews (optional) -----------------------------------------------------
# A temporary public address for a server running in a workspace: Genie allocates
# a port, registers `p<port>.<PREVIEW_DOMAIN>`, and reverse-proxies that name to
# the loopback port. It is one Cerulean-registered wildcard (`*.genie.innotel.us`)
# pointing at this server, so a preview needs no per-preview DNS write or edge
# change and the number of live previews is bounded only by the port range.
# Register the wildcard once with scripts/cerulean-genie-previews.py.
#
# Off by default: a preview is a development server exposed to the network, and a
# command Genie starts for one runs *outside* the command sandbox above — a
# sandbox with no network and no published port cannot serve one. Turn it on
# deliberately, on a host that is meant to answer on the wildcard.
PREVIEW_ENABLED=false
# Run previews somewhere else and make this process their client. Set both and
# this console starts no preview process itself — it forwards to the hosting
# server, which owns the wildcard and the port registry. The token must match that
# server's WEB_TOKEN. Empty keeps everything in one process.
# GENIE_HOSTING_URL=http://192.168.1.24:3400
# GENIE_HOSTING_TOKEN=
PREVIEW_DOMAIN=genie.innotel.us
PREVIEW_SCHEME=https
# Where a preview server listens. 127.0.0.1 keeps it off the network directly;
# the edge reaches Genie, and Genie reaches the port.
PREVIEW_BACKEND_HOST=127.0.0.1
# The inclusive port range previews are allocated from. The address's label is
# the port, so the range is also the number of addresses available at once.
PREVIEW_PORT_START=4000
PREVIEW_PORT_END=4999
# How long a *named* preview address lives, in ms. 0 means it never expires.
PREVIEW_TTL_MS=86400000
# How long a free `p<port>` address lives. They are allocated from one bounded
# port range, so an abandoned one is a port nobody else can publish on; a short
# TTL is what returns the port. 0 means it never expires.
PREVIEW_FREE_TTL_MS=1800000
# How often expired addresses are swept, in ms. 0 disables the timer, but expiry
# is still enforced whenever the registry is read.
PREVIEW_SWEEP_INTERVAL_MS=60000
#
# A paid subscriber may claim a name of their own (`acme.genie.innotel.us`)
# instead of `p<port>`. Magnate holds this bearer and calls
# `POST /api/previews/claim` after checkout, presenting the subscriber it is
# billing. Genie then asks Magnate's entitlement API before it grants the name.
# Leave PREVIEW_CLAIM_TOKEN empty to disable the server-to-server route entirely.
PREVIEW_CLAIM_TOKEN=
MAGNATE_ENTITLEMENTS_URL=
ENTITLEMENTS_API_TOKEN=
MAGNATE_GENIE_PLAN=genie

# --- Live preview ---
# The console's "preview" pane, which runs this project and shows the app rather
# than the code. Which command to run is worked out from the project itself (its
# own `dev`/`start` script, manage.py, or a directory with an index.html), so
# nothing needs setting here for the usual cases. AGENT_PREVIEW_COMMAND names one
# explicitly when the guess is wrong or the project is unusual.
# AGENT_PREVIEW_COMMAND=npm run dev
# AGENT_PREVIEW_PORT is the port the app is asked to listen on. A development
# server that ignores PORT (Vite, Astro) is followed to whatever port it takes,
# so this is a preference, not a requirement.
AGENT_PREVIEW_PORT=5173
#
# --- Publishing the preview on the network ---
# The pane above always works: the console proxies the app, so whoever is looking
# at the console sees it. That address is not usable by anything else — a webhook,
# a phone, an OAuth redirect, or a gateway calling back into the app. Publishing
# gives the app a real address on the network, so those work too. All three
# settings are needed, and each says a different thing:
#
#   AGENT_LAN_IP          the address the deployment is reachable at. Name it in a
#                         container: from inside one, every address this process
#                         can see is a docker bridge address, which is exactly the
#                         address that must not be published. Left empty, Genie
#                         works it out from this host's own interfaces.
#   AGENT_PREVIEW_HOST    what the app binds. "loopback" (default) keeps it private;
#                         "all" binds every interface, which is what a container
#                         published by compose needs.
#   AGENT_PREVIEW_PUBLISH turns the advertised address on. Off, the pane still
#                         says where the app is reachable — it just does not claim
#                         a network address nothing is listening on.
#
# A deployment on one host, published, looks like:
#   AGENT_LAN_IP=192.168.1.21
#   AGENT_PREVIEW_HOST=all
#   AGENT_PREVIEW_PUBLISH=true
# and compose publishes the port the preview uses (the family stack does this):
#   ports: ["${ONTRAK_GENIE_PORT:-3400}:3400",
#           "${ONTRAK_GENIE_PREVIEW_PORT:-5173}:5173"]
#
# With `network_mode: host` (the product-only compose file) there is no port to
# publish: the app bound to `0.0.0.0` is already on this host's LAN address.
#
# Only the port the preview was *told* to use is advertised. A project that
# ignores `PORT` (Vite takes 3000, Astro 4321) is still shown in the pane and is
# honestly reported as *not* on the network, rather than given an address nothing
# forwards to.
#
# One trade, stated rather than hidden: the published app is not behind the
# console's sign-in. Anyone who can reach the port can reach the app, which is
# exactly why publishing is off by default and why the app should not carry
# secrets it would not carry in production.
AGENT_LAN_IP=
AGENT_PREVIEW_HOST=loopback
AGENT_PREVIEW_PUBLISH=false

# Optional: require a bearer token for the web UI and its API. Generate one with
#   openssl rand -hex 24
# and open the UI once as http://<host>:3400/?token=<token>.
WEB_TOKEN=

# --- Tenancy (optional) ------------------------------------------------------
# Attribute each turn to an account, and gate it on that account's quota, through
# Distro's control plane. With this configured a turn spends **that account's**
# gateway key instead of the shared OMNIROUTE_API_KEY above — which is what makes
# per-account quota and usage real — and a turn that cannot be resolved to an
# account is refused rather than quietly spending the operator's key on somebody
# else's behalf.
#
# Both are required for it to be on, and an empty or placeholder token means
# "off", so a fresh checkout stays the single-operator tool it has always been.
#
# Two things to know before turning it on:
#   * `CONTROL_PLANE_INTERNAL_URL` is the plane's **origin**, not a path: this
#     console calls `/api/internal/identity`, `/api/internal/quota-check`,
#     `/api/internal/usage-report` and `/api/internal/audit` under it.
#   * Sign-in is required. The control plane keys accounts on the OIDC subject,
#     and a shared bearer carries no subject to key on, so with this on and the
#     ONTRAK_OIDC_* block below unset every turn is refused.
#   * The disk is keyed the same way. Each account reads and writes
#     `<AGENT_WORKSPACE>/accounts/<account>/`, and keeps its chats and file
#     history under `<AGENT_DATA_DIR>/accounts/<account>/`, so two people on one
#     deployment no longer share files or a chat list — see "Two accounts, two
#     workspaces" in docs/operations.md for the layout and the id sanitizing.
#
# The token is the plane's service credential (`x-control-internal-token`). It is
# never sent to the browser, and neither is any account's gateway key. Like every
# other credential here it may be a `vault://` reference — on the family
# deployment that is exactly what it is, so the value itself never sits in this
# file:
#   CONTROL_INTERNAL_TOKEN=vault://cerulean/ontrak#CONTROL_INTERNAL_TOKEN
CONTROL_PLANE_INTERNAL_URL=
CONTROL_INTERNAL_TOKEN=

# M8: how often (ms) an outage this console lived through is retried to the plane
# so it can page the operator. A control plane that is unreachable cannot be told
# about its own outage while it is happening, so Genie records the window and
# reports it as `controlplane.unreachable` on the next call that succeeds — or on
# this timer, for a console nobody is using, where that call never comes. Empty
# defaults to 60000; 0 leaves it to the next successful call.
# CONTROL_PLANE_OUTAGE_REPORT_INTERVAL_MS=60000

# v1.0: the ceiling **this console** enforces on an account's turns per day.
#
# Deliberately not the plane's quota. The plane is the billing authority and the
# family runs on unlimited usage, so its plan never refuses anyone — which means
# nothing in the plan bounds a runaway agent loop, and that is the only thing
# this number is for. It is counted where each turn is decided (`beginTurn`),
# cleared at midnight UTC, and held in this process rather than in a database,
# so a restart forgives it: a durable counter would be a bill wearing a safety
# belt. Empty or 0 means Genie enforces none and the plane's verdict is the only
# gate; the console shows the number and the turns used against it beside the
# account's spend (`GET /api/account/usage`).
# AGENT_ACCOUNT_CEILING_REQUESTS=200

# --- Sign-in (optional) ------------------------------------------------------
# Put the console behind the family's identity provider (Cerulean's Authentik)
# instead of, or alongside, the shared bearer above. All three of the issuer, the
# client id and the session secret are required — with any of them missing,
# sign-in is off and the server behaves exactly as it did before.
#
# Register a public client with the provider, with this redirect URI (it is
# matched byte for byte, and it must be the address the *browser* reaches — not
# 0.0.0.0, and not the container's own name):
#   http://<host>:3400/api/auth/callback
#
# Note what turning this on does to the bearer: an unauthenticated request is
# refused even when WEB_TOKEN is empty. Enabling sign-in must not leave a
# published port open, and a deployment that means to protect the console with it
# should not be left trusting the loopback default instead.
#
# The bearer still works for API clients that drive the endpoint directly.
ONTRAK_OIDC_ISSUER=
ONTRAK_OIDC_CLIENT_ID=
# Leave empty for a public client using PKCE; set it for a confidential one. On
# a deployment this is a Vault reference, not the secret (see "Cerulean Vault"):
#   ONTRAK_OIDC_CLIENT_SECRET=vault://cerulean/ontrak#ONTRAK_OIDC_CLIENT_SECRET
ONTRAK_OIDC_CLIENT_SECRET=
# Defaults to http://127.0.0.1:<PORT>/api/auth/callback, which is only right on
# the machine itself. A deployment sets this to the address the browser reaches.
#
# Reachable at more than one name? List them comma-separated and each name
# signs in on its own URI — the provider matches the URI byte for byte, so a
# name that is not listed cannot sign in. The entry matching the browser's Host
# is chosen:
#   ONTRAK_OIDC_REDIRECT_URL=https://genie.ontrak.innotel.us/api/auth/callback,https://genie.innotel.us/api/auth/callback
ONTRAK_OIDC_REDIRECT_URL=
# Signs the session cookie. Required: there is no default, because a cookie
# signed with a placeholder is a session anybody can mint. Generate one with
#   openssl rand -hex 32
# On a deployment this is a Vault reference, not the secret:
#   ONTRAK_OIDC_SESSION_SECRET=vault://cerulean/ontrak#ONTRAK_OIDC_SESSION_SECRET
ONTRAK_OIDC_SESSION_SECRET=
# How long a sign-in lasts before the person is sent back to the provider.
ONTRAK_OIDC_SESSION_HOURS=12

# ─────────────────────────────────────────────────────────────────────────────
# Repository-aware workspaces (v0.4)
#
# The console can take a repository as the source of a workspace: clone it, make
# a branch, and open a pull request. AGENT_GIT_BASE_URL is the host that serves
# the repository's web UI — the console resolves owner/name against it, so a
# caller can never name a host of their own to dial. Empty (the default) means
# the feature is off rather than half-configured.
#
# AGENT_GIT_TOKEN is the credential for a private clone, a push and a pull
# request. It is supplied per git command and never written into the workspace's
# .git/config, and it is redacted out of anything a git error echoes back:
#   AGENT_GIT_TOKEN=vault://cerulean/ontrak#AGENT_GIT_TOKEN
# Leave empty to clone public repositories only (opening a PR needs a token).
AGENT_GIT_BASE_URL=
AGENT_GIT_TOKEN=
# The branch a pull request is opened against when the caller names none.
AGENT_GIT_DEFAULT_BRANCH=main
