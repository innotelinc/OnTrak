[TEMPLATE]
# ---------------------------------------------------------------------------
# OnTrak Genie — production configuration.
#
# Copy to `.env.production` and fill it in:
#
#     cp .env.production.example .env.production
#     make genie-prod-up
#
# `.env.production` is gitignored and must never be committed — this template
# carries placeholders only, never a real value.
#
# OPTIONAL — which release this deployment runs. The overlay pulls every image it
# names with the same tag, so one value moves the whole thing: leave it unset to
# follow `latest`, the build the last release published and the default, or set a
# version to hold this deployment on one build — the rollback path.
# ONTRAK_IMAGE_TAG=0.1.1
#
# This file *is* the deployment's configuration: the overlay hands it to the
# container as the whole environment and does not read `.env`, so everything
# `.env.example` documents applies here. The values below are the ones a
# deployment has to decide, because the development defaults are wrong off this
# host. On the platform the credentials are Cerulean Vault references the
# entrypoint resolves before the server starts (`vault://<mount>/<path>#<key>`)
# rather than literals — see the "Cerulean Vault" section of `.env.example`.
# ---------------------------------------------------------------------------

# REQUIRED — the model gateway Genie asks for completions. `OMNIROUTE_URL` must
# be an address *this host* can route to (the shared OmniRoute on the LAN, never
# a service name that exists only inside another compose project), and it ends
# in /v1. There is no working default: an empty one points the console at its
# own loopback, where no gateway is listening.
OMNIROUTE_URL="http://<gateway-host>:20128/v1"

# REQUIRED — the bearer key for that gateway. Do not write the value here: it is
# a credential, and on the platform it lives in Cerulean Vault. Set the
# reference, fill in the three VAULT_* values, and mount this stack's
# path-scoped token (the commented volume in `docker-compose.prod.yml`).
OMNIROUTE_API_KEY="vault://cerulean/ontrak#OMNIROUTE_API_KEY"
VAULT_ADDR="http://<vault-host>:8200"
VAULT_TOKEN_FILE="/vault/token/ontrak.token"
VAULT_PREFIX="cerulean"

# The gateway’s browser-facing address, used in the one message that sends
# somebody to it. `OMNIROUTE_URL` above is what *this host* dials — a LAN
# address — and naming that one sends a browser somewhere it cannot go, at a
# callback the gateway’s own SSO provider has not registered. Set the
# gateway’s public address so the instruction actually works.
AGENT_GATEWAY_CONSOLE_URL="https://gateway.studio.innotel.us"

# The model and, after it, the fallbacks the resilience chain walks. Same
# `provider/model` shape the gateway advertises; the gateway decides which
# upstream answers, so this is a routing preference rather than a provider key.
#
# The default is the gateway's own `auto/*` routes rather than pinned model ids:
# a curated list is only as available as the credentials behind it, and when the
# providers it is drawn from go dark together every entry fails at once (the
# sidebar then reads "models 0/5 ready"). `auto/*` is resolved per request across
# whatever credentials are live.
AGENT_MODEL="auto/coding"
# AGENT_FALLBACK_MODELS="auto/best-coding,auto/best-chat,auto/thrifty"

# Host address the console binds. Host networking, so this *is* the published
# port; :3400 belongs to the family stack's `genie-app` when this runs beside
# it, which is why the default is :3410.
ONTRAK_GENIE_PORT="3410"

# Optional: require a bearer token on the console for API clients that do not
# sign in. Anyone who can reach the port can read, edit and run code in the
# workspace, so a published port needs a credential — this one, or sign-in
# below. Generate one with `openssl rand -hex 24`, and treat it like any other
# secret (a `vault://` reference works here too).
# WEB_TOKEN=""

# Optional: sign-in, through the same Cerulean Authentik client as the rest of
# the family. All three are required for it to be on, and turning it on refuses
# unauthenticated calls even with an empty WEB_TOKEN — which is the point. The
# redirect URI must be the address the *browser* reaches, byte for byte:
# https://<name>/api/auth/callback.
# ONTRAK_OIDC_ISSUER="https://auth.cerulean.innotel.us/application/o/ontrak"
# ONTRAK_OIDC_CLIENT_ID="ontrak"
# ONTRAK_OIDC_CLIENT_SECRET="vault://cerulean/ontrak#ONTRAK_OIDC_CLIENT_SECRET"
# ONTRAK_OIDC_SESSION_SECRET="vault://cerulean/ontrak#ONTRAK_OIDC_SESSION_SECRET"
# ONTRAK_OIDC_REDIRECT_URL="https://<name>/api/auth/callback"

# Optional: attribute each turn to an account, through Distro's control plane,
# and gate it on that account's quota. Both are required for it to be on, and
# sign-in is required for it to mean anything — the plane keys accounts on the
# OIDC subject, and a shared bearer carries none. Like every other credential
# here the service token may be a `vault://` reference.
# CONTROL_PLANE_INTERNAL_URL="http://<control-plane-host>:20140"
# CONTROL_INTERNAL_TOKEN="vault://cerulean/ontrak#CONTROL_INTERNAL_TOKEN"
