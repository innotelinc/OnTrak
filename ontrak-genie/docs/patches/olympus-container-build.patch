diff --git a/compose.nested-userns.yml b/compose.nested-userns.yml
new file mode 100644
index 0000000..e3a9554
--- /dev/null
+++ b/compose.nested-userns.yml
@@ -0,0 +1,47 @@
+# compose.nested-userns.yml — run the Olympus container on a host whose kernel
+# denies unprivileged user namespaces to containers.
+#
+# WHY THIS FILE EXISTS. The `build` node of `archon-greenfield` runs Codex, and
+# Codex sandboxes every shell call with bubblewrap, which needs its own user and
+# network namespace. Docker's default seccomp profile refuses `clone(CLONE_NEWUSER)`,
+# so inside a stock container the sandbox cannot start and the failure is silent in
+# the worst way: Codex exits **0** having written nothing, three times, and the node
+# reports "all agent attempts produced no project files" — which reads like a model
+# problem and is a container problem.
+#
+#     $ docker compose exec olympus unshare -Urn true
+#     unshare: unshare failed: Operation not permitted
+#
+# Olympus documents this class of host in `scripts/install-build-runner.sh`, and it
+# is right that the answer is not "run the agent unsandboxed". Two ways to get the
+# namespace, and the second is better where it is available:
+#
+#   1. **This file.** Turn the profile off for this one container, so bubblewrap can
+#      create the namespace it wants. It is a real reduction in kernel-level
+#      confinement — seccomp is what stops a container from making syscalls it has
+#      no business making — which is why it is opt-in rather than the default, and
+#      why it is scoped to the service that builds rather than to the stack.
+#
+#   2. **On the host:** allow unprivileged user namespaces instead.
+#
+#          sudo sysctl -w kernel.unprivileged_userns_clone=1        # Debian/Ubuntu
+#          sudo sysctl -w user.max_user_namespaces=15000            # RHEL/Fedora
+#
+#      Persist it in `/etc/sysctl.d/`. This keeps the default seccomp profile and is
+#      the answer to prefer; use this file when the host is not yours to change.
+#
+#     $ unshare -Urn true && echo ok      # on the host, before either
+#
+# Usage, alongside the normal compose file:
+#
+#     docker compose -f docker-compose.yml -f compose.nested-userns.yml up -d
+#
+# There is no `docker-compose.override.yml` here on purpose: an override file is
+# picked up automatically, and a security posture nobody chose explicitly is the
+# one that gets shipped by accident.
+
+services:
+  olympus:
+    security_opt:
+      - seccomp=unconfined
+      - apparmor=unconfined
