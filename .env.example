# ============================================================================
# OnTrak — environment template
#
# Copy to `.env` (never commit `.env`; it is gitignored) or export the variables in
# the service environment. Every key below maps onto config/ontrak.yaml as
# ONTRAK_<SECTION>__<KEY>; values are parsed as YAML, so booleans and numbers do not
# need quoting.
#
# This file is also meant to be *sourced* — `set -a; . ./.env; set +a` is how a host
# command picks up the range's own settings — so a value containing a space or a comma
# is quoted. The quotes are for the shell and the app strips them (see
# `_unquote_shell`), so `'[45, 90, 180]'` is still the list it looks like.
#
# Secrets posture
# ---------------
# Production secrets come from **Cerulean Vault** (SecretOps, KV v2) and are referenced
# in the deployment as `vault://<mount>/<path>#<key>`; the service resolves them at boot.
# `.env` is local-only and gitignored: it either holds a reference the deployment
# resolves, or the resolved value where nothing resolves it — a reference that nothing
# resolves is a deployment error, never a silent fallback.
#
# Platform services this repo consumes
# ------------------------------------
#   Identity (SSO)   : Cerulean — Authentik          https://auth.cerulean.innotel.us/
#   Secrets          : Cerulean Vault (KV v2)        vault://ontrak/range#guest_password
#   DNS + TLS        : Cerulean (wildcard cert)      provisioned, never edited by hand
#                      `make provision` — scripts/cerulean-provision.py, over the
#                      service bridge, with a ceru_ key scoped domains, dns, certs, npm
#   Edge             : NPM Edge                      serves the portal and console hosts
#   Storage (durable): ONYX                          built images and snapshot backups
#   Billing          : Magnate — not used today; if ranges are ever sold per seat, set
#                      MAGNATE_URL and ENTITLEMENTS_API_TOKEN (the token must equal
#                      Magnate's ENTITLEMENTS_API_TOKEN).
#
# Never put a real secret, key or public IP in this file.
# ============================================================================

# ── Range identity ───────────────────────────────────────────────────────────
# Public host for the student portal (Cerulean issues the record + certificate).
ONTRAK_PORTAL__HOST=0.0.0.0
ONTRAK_PORTAL__PORT=8080
ONTRAK_PORTAL__TITLE=OnTrak
ONTRAK_PORTAL__BRAND_NOTE="IT support training range — powered by Innotel OnTrak"

# Browser console gateway: the address a *student's browser* resolves — not what
# the container can reach.
#
#   auto         (default) derive it from the address the student used to reach the
#                portal, so the console follows a localhost, a LAN address, a phone
#                hotspot or a TLS host with no edit. This is what makes one checkout
#                work anywhere.
#   <absolute>   give the URL outright. What a deployment behind an edge sets,
#                because the browser name is not the container's own:
#                  https://ontrak.innotel.us/guacamole/
#                The estate serves the range on three names, all provisioned through
#                Cerulean (DNS + wildcard TLS + edge host) — `make provision-plan`
#                shows what that would change, `make provision` does it:
#                  range     https://ontrak.innotel.us/          portal + console at /guacamole/
#                  students  https://student.ontrak.innotel.us/  what a student opens
#                  staff     https://admin.ontrak.innotel.us/    what an instructor opens
#
#                Those names are optional, and a range run on its own LAN does not have
#                them: an address is enough, and nothing in the stack resolves a hostname
#                of its own. A host reached at https://192.168.1.24:8443/ wants `auto`
#                (the default) — the panel's Overview page shows the address to hand out.
#   (empty)      no browser console; the portal says so instead of embedding a frame.
#
# Whichever you set, keep the console on the same *origin* as the portal. Guacamole
# remembers its session in the browser's localStorage, which is per origin, and the
# portal's console page clears that memory before opening a machine — which it can
# only do when both are on one origin. A console on a different origin than the
# portal can leave a student staring at the last machine that browser opened.
ONTRAK_GUAC__BASE_URL=auto

# ── Secrets (fill these; generate the hex ones with `openssl rand -hex 16`) ──
# Guest local-admin password baked into the training images.
ONTRAK_GUEST__PASSWORD=
# Signs portal session cookies.
ONTRAK_PORTAL__SECRET=
# 32 hex characters. Must be identical to JSON_SECRET_KEY in the gateway's env:
# the portal signs single-session console links with it and Guacamole verifies them.
ONTRAK_GUAC__SECRET_KEY=

# ── Container stack (docker-compose.yml · docs/docker.md) ───────────────────
# Interface the published port binds to. 0.0.0.0 is the default: OnTrak is a
# setup-anywhere lab, and a stack that only answers on the machine it runs on is
# unreachable from the phone, tablet or laptop that is meant to use it. Set it back
# to 127.0.0.1 to keep the range on one machine, or to a specific address to pin it
# to one interface. The console follows automatically (ONTRAK_GUAC__BASE_URL=auto).
ONTRAK_BIND_ADDR=0.0.0.0
# `make up` turns TLS on by default (docker-compose.tls.yml): the gateway publishes
# this port *instead of* 8080 — TLS only, no unencrypted door beside it. The
# certificate is self-signed and local (scripts/tls-local-cert.sh); a range behind
# Cerulean's edge uses `make up-plain` instead. (Compose-level: the app never reads it.)
ONTRAK_TLS_PORT=8443
# The one published host port. The stack's origin gateway owns it and routes `/`
# to the portal and `/guacamole/` to the console, so there is no second port to
# collide with whatever else the machine is running.
ONTRAK_PORTAL__PORT=8080
# Tag `make build` produces. Set it to a registry path to ship the image.
ONTRAK_IMAGE=ontrak:local
# Session recording from guacd, written to deploy/guacamole/recordings. Large,
# and it shows a student's screen: off unless an instructor asks for it.
ONTRAK_GUAC__RECORDING=false

# ── Sign-in (docs/operations.md "Sign-in") ──────────────────────────────────
# SSO is optional, and off by default: a fresh range signs in with local accounts,
# so it is usable with nothing else installed. Switch it on in the admin panel
# (Admin -> Sign-in) once the values below are set — the switch is stored in the
# portal database, so this variable only seeds a range that has never been
# switched on or off. For an unattended setup, ONTRAK_PORTAL__ADMIN_PASSWORD
# seeds the first instructor account at startup; without it (and with no account
# yet) the portal serves a one-time /setup page instead.
ONTRAK_PORTAL__SSO_ENABLED=false
ONTRAK_PORTAL__ADMIN_USERNAME=admin
ONTRAK_PORTAL__ADMIN_PASSWORD=

# ── Cerulean / Authentik (only needed once SSO is switched on) ──────────────
# Cerulean registers this application (`python3 scripts/authentik-setup.py
# ontrak` there, with AUTHENTIK_ONTRAK_* in its .env). All four values below are
# needed — with any one missing the SSO button cannot be switched on, and the
# login page falls back to local accounts rather than offering a button that
# leads nowhere.
ONTRAK_PORTAL__OIDC_ISSUER=https://auth.cerulean.innotel.us/application/o/ontrak/
ONTRAK_PORTAL__OIDC_CLIENT_ID=ontrak
# Printed by the provisioning run above. A `vault://` reference belongs here too
# if the deployment gives the container something that can resolve one.
ONTRAK_PORTAL__OIDC_CLIENT_SECRET=
# The sign-in returns to the origin it started on, and Authentik only accepts a
# callback it was registered with — so every origin the portal answers on is
# listed, and the range, the student name and the staff name are three of them
# (scripts/cerulean-provision.py creates all three).
ONTRAK_PORTAL__OIDC_REDIRECT_URI='https://ontrak.innotel.us/oidc/callback,https://student.ontrak.innotel.us/oidc/callback,https://admin.ontrak.innotel.us/oidc/callback'
# Members of this Authentik group are instructors; everyone else who signs in is
# a student. Blank promotes nobody, not even the first account.
ONTRAK_PORTAL__OIDC_INSTRUCTOR_GROUP=range-instructors
# When set, only members of this group may sign in at all — one class cohort per
# range. Blank admits any account Authentik authenticates.
ONTRAK_PORTAL__OIDC_REQUIRED_GROUP=
# With SSO on, an account appears on the range the first time its owner signs in,
# and it carries no password — the local password form can never open it. People
# are added, renamed and offboarded in Authentik; the admin panel only enables,
# disables and deletes the local row.

# ── Cerulean service bridge (make provision) ────────────────────────────────
# The ceru_ service key scripts/cerulean-provision.py needs, scoped domains,
# dns, certs and npm (Cerulean → Platform → Service API keys → name "ontrak").
# It is the bootstrap credential for provisioning itself, so nothing resolves it
# from Vault: .env is gitignored and local-only, and the operator exports it
# before running the tool —
#   set -a; . ./.env; set +a; make provision
# Without it `make provision` exits 2 and the names are left to whoever set them
# up by hand, which is how an edge host ends up pointing at the old range host.
CERULEAN_API_TOKEN=

# ── Hypervisor (Incus) ──────────────────────────────────────────────────────
ONTRAK_INCUS__REMOTE=local
ONTRAK_INCUS__PROJECT=ontrak
ONTRAK_INCUS__STORAGE_POOL=default        # ZFS or btrfs: clones are what makes reset cheap
ONTRAK_INCUS__NETWORK=ontrak0             # managed bridge, no route to the corporate LAN
ONTRAK_INCUS__PROFILE=ontrak-student
ONTRAK_INCUS__IMAGE_ALIAS=ontrak-win-base # golden image built by infra/build-golden-image.sh

# ── Guest automation ────────────────────────────────────────────────────────
# winrm (default), incus-exec (needs the Incus agent in the image), ssh (Linux), or
# null (no-op: dry runs and CI).
ONTRAK_GUEST__DRIVER=winrm
ONTRAK_GUEST__USER=student
ONTRAK_GUEST__WINRM_TRANSPORT=ntlm
ONTRAK_GUEST__STATIC_HOST=               # set to drive one fixed Windows box in dev
ONTRAK_GUEST__RDP_PORT=3389              # what a Windows guest's console dials
ONTRAK_GUEST__SSH_PORT=22                # what a Linux guest's console dials
ONTRAK_GUEST__LINUX_USER=root            # the account the Linux console and grading run as

# The Linux console: SSH in the browser instead of RDP.
#
# A Linux container answers no RDP at all, so a Linux scenario's console is an SSH
# shell. This is on by default: `ontrak template build` installs openssh-server, sets
# the Linux account's password (ONTRAK_GUEST__LINUX_USER) to ONTRAK_GUEST__PASSWORD
# and enables password login, and it **refuses** to build with an empty password.
# Templates are snapshots, so a template built before this was on has no sshd in it
# and its console still says the guest is unreachable — rebuild the Linux templates
# (`ontrak template build --all --force`, or `make templates`) after changing this.
# Set it false for a range whose Linux guests must not open port 22: a Linux
# scenario then has no console, and the page says why instead of embedding one that
# cannot connect. See docs/operations.md.
ONTRAK_GUAC__LINUX_SSH=true

# ── Sessions ────────────────────────────────────────────────────────────────
ONTRAK_SESSION__TTL_MINUTES=90
# Idle means no sign of the student, and the sign is the portal: the session page
# beats /sessions/<id>/heartbeat while it is open, and the console is a frame on it.
# Nothing done inside the console reaches the portal (the gateway serves it), so this
# is how long a student's machine survives the page being closed — not how long their
# work does.
ONTRAK_SESSION__IDLE_RECYCLE_MINUTES=20
ONTRAK_SESSION__MAX_PER_STUDENT=1
ONTRAK_SESSION__PERSIST_PROGRESS=false    # results only: only Complete & End is stored
# Quoted because the list has commas in it: unquoted, a shell sourcing this file runs
# `90,` as a command and leaves the variable holding `[45,`. The app reads either.
ONTRAK_SESSION__TIME_LIMIT_CHOICES='[45, 90, 180]'

# Housekeeping, run by the portal itself (ontrak/maintenance.py). The container stack
# has no cron for `ontrak reap` to live in, so without this an expired session keeps
# its machine until somebody runs a command. It reaps expired and idle sessions, and
# once a day deletes finished history older than ONTRAK_SESSION__HISTORY_DAYS
# (0 = keep it forever; a session a result or ticket points at is never deleted).
# It never refills the pool: that is capacity policy, and a background thread booting
# machines on a small host is not what `setup anywhere` means. `false` turns it off.
ONTRAK_SESSION__MAINTENANCE_ENABLED=true
ONTRAK_SESSION__MAINTENANCE_INTERVAL_SECONDS=60
ONTRAK_SESSION__HISTORY_DAYS=30

# ── Warm pool ───────────────────────────────────────────────────────────────
ONTRAK_POOL__ENABLED=true
ONTRAK_POOL__DEFAULT_TARGET=0             # 0 keeps host RAM free between classes
ONTRAK_POOL__TARGETS={}
ONTRAK_POOL__MAX_TOTAL=60                 # ceiling across all scenarios (RAM guard rail)

# ── Automatic assignment ────────────────────────────────────────────────────
ONTRAK_SELECTION__STRATEGY=balanced        # balanced | random | family | hardest | easiest
ONTRAK_SELECTION__AUTO_ASSIGN=true

# ── Scheduled windows (prewarm before a class, drain after it) ──────────────
ONTRAK_SCHEDULE__ENABLED=false
ONTRAK_SCHEDULE__WINDOWS=[]

# ── Paths ───────────────────────────────────────────────────────────────────
ONTRAK_PATHS__CATALOG=catalog
ONTRAK_PATHS__MEDIA=media                  # free media is downloaded here; licensed media is yours
ONTRAK_PATHS__STATE=state

