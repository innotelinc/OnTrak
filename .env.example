# Ontrak Sync — environment template. Copy to `.env` and fill in.
#
# Never commit `.env` — it is gitignored and local-only. This file is the
# template and IS committed.
#
# Every value here has a working default EXCEPT the two credentials, which are
# deliberately required: a service that can install packages across the estate
# must not come up answering unauthenticated requests while somebody remembers to
# set it, and it must not have to guess its way onto the estate hosts.

# ── the estate this deployment is responsible for ────────────────────────────
# `name=address[:kind[:user]]`, comma-separated. `kind` is `incus`, `docker` or
# `both` and only decides HOW a host is inspected.
#
# Nothing discovers these: incus hosts do not advertise themselves, so this list IS
# the scope. A host that is listed and unreachable is reported as unreachable and is
# never silently dropped.
ONTRAK_HOSTS=i1=192.168.1.51:both,i2=192.168.1.52:both,i3=192.168.1.53:both

# ── identity ────────────────────────────────────────────────────────────────
# REQUIRED. Generate with: openssl rand -hex 32
# This is the token the dashboard sends as `Authorization: Bearer <token>`.
ONTRAK_API_TOKEN=

# ── secrets posture (Cerulean Vault — SecretOps) ────────────────────────────
# Production secrets come from **Cerulean Vault** (HashiCorp Vault, KV v2),
# referenced as `vault://<mount>/<path>#<key>`. This repo ships no resolver, so
# `.env` must hold the resolved value: a reference left in place reaches the
# container as a literal string, which is a deployment error and never a
# fallback. The empty values above are the template; the local-development form
# is a generated value, never a committed one.

# ── where it listens ────────────────────────────────────────────────────────
ONTRAK_BIND_HOST=0.0.0.0
ONTRAK_BIND_PORT=8420

# Addresses published on the host by compose. The dashboard is reached from a
# browser, so both need to be on the LAN rather than loopback.
ONTRAK_API_BIND=192.168.1.21
ONTRAK_WEB_BIND=192.168.1.21
# The API address the BROWSER will use. Baked into the web image at build time.
ONTRAK_PUBLIC_API=http://192.168.1.21:8420

# ── the SSH key used to reach the estate ────────────────────────────────────
# Mounted read-only into the API container. Generated by scripts/setup.sh and
# authorised on each incus host's root account.
ONTRAK_SSH_KEY=/root/.ssh/id_ed25519
ONTRAK_SSH_KNOWN_HOSTS=/root/.ssh/known_hosts

# ── the timer ───────────────────────────────────────────────────────────────
# The scheduler lives in the API process (see ontrak/scheduler.py). Turning it off
# leaves manual scans and applies working, which is what you want while debugging a
# schedule that fires at the wrong time.
ONTRAK_SCHEDULER=true
ONTRAK_SCHEDULER_TICK=30
# Defaults used only until the settings form saves a policy — the database wins.
# Quoted because the value contains spaces: the same file is read by compose, by
# `docker run --env-file` and by `make scan`, which sources it in a shell, and only
# two of those three understand an unquoted value with spaces in it.
ONTRAK_DEFAULT_SCHEDULE="0 4 * * 0"
ONTRAK_DEFAULT_MODE=detect

# ── timeouts ────────────────────────────────────────────────────────────────
# SSH connect/probe timeout, and the ceiling for one long command (docker pull on a
# large image). Both are sized for commands that answer promptly.
ONTRAK_SSH_TIMEOUT=20
ONTRAK_COMMAND_TIMEOUT=300
# apt runs on its own, longer clock, because one transcript is two jobs: an
# `apt-get update` from a mirror that answers in seconds on a good day and minutes on
# a bad one, plus the upgrade behind it. Against the probe ceiling above, five estate
# hosts hit the wall in one run and every finding on them was recorded as failed —
# including packages whose upgrade had already landed. A timeout is no longer failure
# by itself: the verdict is re-read with `apt list --upgradable`, so this setting only
# decides how long that wait is allowed to be.
ONTRAK_APT_TIMEOUT=900

# ── registry thrift ─────────────────────────────────────────────────────────
# Seconds a fetched remote image digest is reused before Docker Hub is asked again.
# Every image check is one anonymous request out of a budget of roughly a hundred per
# six hours per address, and the estate's image PULLS come out of the same budget — so
# a scan that re-asks for digests it fetched an hour ago is what makes an update fail
# with `429 Too Many Requests`. Six hours is long enough that two scans in an
# afternoon cost one pass of requests, and short enough that a republished tag is
# picked up by the next scheduled run. Set to 0 to ask every time.
ONTRAK_DIGEST_TTL=21600

ONTRAK_DB=/var/lib/ontrak/ontrak.sqlite3

# ── provisioning (scripts/setup.sh only) ────────────────────────────────────
# The incus host's root password, used ONLY by scripts/setup.sh: it creates the
# container and authorises this deployment's SSH key on each estate host. The
# running service never reads it. There is deliberately no default in the script,
# so a moment's convenience cannot become a committed credential — export it, or
# put it here.
ONTRAK_INCUS_PASSWORD=

# ── Cerulean (TrustOps — DNS / TLS / NPM Edge) ──────────────────────────────
# Cerulean owns the public DNS name, the certificate, and the NPM proxy host for
# the dashboard, and hosts the optional Authentik SSO in front of it. Nothing in
# this repo calls the NPM API: the edge is consumed, not administered, from here.
# The dashboard's only credential is a bearer token, so docs/placement.md is
# explicit that it belongs behind that edge like every other admin surface.
CERULEAN_DNS_API_URL=http://127.0.0.1:3003
CERULEAN_ZONE=innotel.us
