# ---------------------------------------------------------------------------
# OnTrak — environment configuration
#
# Copy to `.env` and adjust:   cp .env.example .env
#
# `.env` is gitignored and must never be committed. This template carries
# placeholders and generated-value recipes only; it never carries a real secret.
#
# --- Shared Innotel platform services ---------------------------------------
# OnTrak consumes the platform services rather than re-implementing them, and
# every one of them is optional — the app boots and is useful with none set.
#
#   Identity / SSO   Authentik, hosted in Cerulean. The training app signs in
#                    against its own credential store by default; a deployment
#                    that puts it behind the stack's identity provider does so at
#                    the edge and points the same app at it. OnTrak Tix speaks
#                    OIDC directly — see `ontrak-tix/.env.example` for its issuer,
#                    client id and redirect URI.
#   Secrets          Cerulean Vault (HashiCorp Vault KV v2). Production secrets
#                    are read as `vault://<mount>/<path>#<key>` references, which
#                    the deployment resolves before the app starts. A `.env` here
#                    holds either such a reference (where a resolver exists) or
#                    the resolved value (where none does) — a reference nothing
#                    resolves is a deployment error, never a fallback.
#   Trust / DNS/TLS  Cerulean owns the host's records and the stack wildcard
#                    certificate. Nothing in this repo holds a certificate or key.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.  `npm run docker:db` starts a matching container.
# Running from source, this is the address of the container it starts. Inside
# `docker compose up` the app is given the equivalent URL for the stack's own
# `db` service instead — this value is not used there.
DATABASE_URL="postgresql://ontrak:ontrak@localhost:5432/ontrak?schema=public"

# Host port the compose stack publishes its database on. The other two stacks
# are 5433 (Tix) and 5434 (Sentinel), so all three can run at once; this one is
# the primary and keeps 5432.
# ONTRAK_DB_PORT="5432"

# Secret used to sign session cookies.  Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# In a stack deployment this is a Cerulean Vault reference rather than a literal:
#   AUTH_SECRET="vault://secret/ontrak#auth_secret"
AUTH_SECRET="change-me-to-a-long-random-string"

# How long a login session stays valid, in seconds (default 7 days)
SESSION_TTL_SECONDS="604800"

# Whether the session cookie is marked `Secure` (TLS-only). Default `auto`
# follows the request: the cookie is restricted when the request arrives over
# https (directly or as `X-Forwarded-Proto: https` from a TLS terminator), and
# is not restricted otherwise. That default exists because a browser refuses to
# store a `Secure` cookie from an insecure origin, everywhere but `localhost` —
# so a plain-HTTP deployment that hard-codes the flag signs everyone in on the
# machine it runs on and silently signs everyone else out. Set `always` behind a
# terminator that does not report the scheme, or `never` for a deployment whose
# TLS is handled elsewhere entirely. Accepts always|never|true|false|1|0|yes|
# no|on|off; anything else means `auto`.
# AUTH_COOKIE_SECURE="auto"

# Directory used to store uploaded software packages / image bundles.
# Relative paths are resolved from the project root.
STORAGE_DIR="./storage/packages"

# Maximum accepted upload size in megabytes for a single software package.
MAX_UPLOAD_MB="512"

# Shown in the UI header and the PWA manifest.
NEXT_PUBLIC_APP_NAME="OnTrak IT Support Training"

# Set to "false" to disable open student self-registration.
NEXT_PUBLIC_ALLOW_SELF_REGISTRATION="true"

# Password given to the seeded demo accounts. Must be at least 8 characters to
# satisfy the sign-in schema's minimum length. The value below is the shipped
# placeholder, and it *reads* as one on purpose (the same posture the rest of the
# stack takes): set your own before a deployment is reachable by anyone you do
# not hand the password to.
SEED_PASSWORD="change-me-ontrak"

# Dev-only: hosts allowed to call server actions when the app is opened from a
# LAN address or a tunnel (otherwise login etc. fail with "Failed to fetch").
# The host's own localhost and LAN addresses are detected automatically; set this
# comma-separated list only when reaching the app by a name those miss (a tunnel
# hostname, for example).
# ONTRAK_ALLOWED_DEV_ORIGINS="tix.example.test"

# --- Browser accessibility sweep (`npm run test:a11y`, Playwright + axe) ------
# The sweep boots the app itself; set ONTRAK_A11Y_BASE_URL to audit an
# already-running instance instead. The signed-in cases use the demo student and
# fall back to self-registering a throwaway one, skipping when neither works.
ONTRAK_A11Y_EMAIL="student@ontrak.local"
ONTRAK_A11Y_PASSWORD="change-me-ontrak"
# ONTRAK_A11Y_BASE_URL="http://127.0.0.1:3000"
# ONTRAK_A11Y_PORT="3210"

# --- Certificates (`src/lib/certificates.ts`) --------------------------------
# The organisation that issues completion records, as printed on a certificate
# and written into the signed record itself. Defaults to the product name; set it
# so a deployment's certificates are attributed to the organisation it trains for.
# Changing it changes the digest, and therefore the code, of every record.
# ONTRAK_ISSUER="Springfield College"
