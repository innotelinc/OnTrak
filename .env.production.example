[TEMPLATE]
# ---------------------------------------------------------------------------
# OnTrak IT Support Training — production configuration.
#
# Copy to `.env.production` and fill it in:
#
#     cp .env.production.example .env.production
#     make prod-up
#
# `.env.production` is gitignored and must never be committed — this template
# carries placeholders only, never a real value.
#
# OPTIONAL — which release this deployment runs. The overlay pulls every image it
# names with the same tag, so one value moves the whole thing: leave it unset to
# follow `latest`, the build the last release published and the default, or set a
# version to hold this deployment on one build — the rollback path.
# ONTRAK_IMAGE_TAG=0.1.1
#
# The overlay `docker-compose.prod.yml` refuses to start without the two
# REQUIRED values below, because the development placeholders in `.env` are
# public knowledge and a deployment that quietly accepted them would be worse
# than one that stopped.
#
# In a stack deployment these are Cerulean Vault references the deployment
# resolves before the app starts (`vault://<mount>/<path>#<key>`), not literals.
# ---------------------------------------------------------------------------

# REQUIRED — signs every session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# REQUIRED — the password the Postgres role is created with. Note that changing
# it later does not change an existing database's password: that needs
# `ALTER USER ontrak WITH PASSWORD ...` against the running database.
POSTGRES_PASSWORD=""

# How long a login session stays valid, in seconds (default 7 days)
SESSION_TTL_SECONDS="604800"

# Maximum accepted upload size in megabytes for a single software package.
MAX_UPLOAD_MB="512"

# Shown in the UI header and the PWA manifest. Both of these are read when the
# image is *built*, so changing them means rebuilding, not just restarting.
NEXT_PUBLIC_APP_NAME="OnTrak IT Support Training"
# A real cohort is provisioned by an administrator; leave self-registration off.
NEXT_PUBLIC_ALLOW_SELF_REGISTRATION="false"

# Host port the app is published on. Put it behind the platform's reverse proxy
# and certificate rather than exposing it directly.
ONTRAK_HTTP_PORT="3000"

# --- Platform services (all optional) ---------------------------------------
# OnTrak consumes these rather than re-implementing them, and boots with none of
# them set. See docs/stack.md.
# ONTRAK_ALLOWED_DEV_ORIGINS=""
# ONTRAK_ISSUER=""
